<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" TextQuality="Regular" ReportInfo.Description="Reporte de rendimiento del docente por notas de sus alumnos" ReportInfo.Created="08/19/2026" ReportInfo.CreatorVersion="2026.2.3.0">
  <Dictionary>
    <Parameter Name="DocenteNombre" DataType="System.String"/>
    <Parameter Name="DocenteLegajo" DataType="System.String"/>
    <Parameter Name="FechaGeneracion" DataType="System.String"/>
    <TableDataSource Name="Rendimiento" ReferenceName="Rendimiento" DataType="System.Int32" Enabled="true">
      <Column Name="Materia" DataType="System.String"/>
      <Column Name="Comision" DataType="System.String"/>
      <Column Name="Anio" DataType="System.Int32"/>
      <Column Name="CargoTexto" DataType="System.String"/>
      <Column Name="Inscriptos" DataType="System.Int32"/>
      <Column Name="Aprobados" DataType="System.Int32"/>
      <Column Name="Regulares" DataType="System.Int32"/>
      <Column Name="SinNota" DataType="System.Int32"/>
      <Column Name="PromedioTexto" DataType="System.String"/>
    </TableDataSource>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="297" PaperHeight="210" LeftMargin="40" RightMargin="40" TopMargin="15" BottomMargin="15">
    <ReportTitleBand Name="ReportTitle1" Width="840" Height="450">
      <TextObject Name="Title" Left="0" Top="0" Width="840" Height="36" Text="Reporte de Rendimiento Docente" HorzAlign="Center" Font="Segoe UI, 20pt, style=Bold" TextFill.Color="CornflowerBlue"/>
      <TextObject Name="SubTituloNombre" Left="0" Top="40" Width="840" Height="22" Text="Docente: [DocenteNombre] - Legajo: [DocenteLegajo]" HorzAlign="Center" Font="Segoe UI, 11pt, style=Bold"/>
      <TextObject Name="SubTituloFecha" Left="0" Top="64" Width="840" Height="14" Text="Generado: [FechaGeneracion]" HorzAlign="Center" Font="Segoe UI, 9pt" TextFill.Color="Gray"/>
      <PictureObject Name="GraficoGeneral" Left="60" Top="84" Width="720" Height="360" ImageFormat="Png"/>
    </ReportTitleBand>
    <DataHeaderBand Name="HeaderResumen" Top="454" Width="840" Height="30">
      <TextObject Name="HMateria" Left="0" Top="0" Width="210" Height="30" Text="Materia" Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HComision" Left="210" Top="0" Width="95" Height="30" Text="Comisión" Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HAnio" Left="305" Top="0" Width="60" Height="30" Text="Año" HorzAlign="Center" Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HCargo" Left="365" Top="0" Width="125" Height="30" Text="Cargo" Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HInscriptos" Left="490" Top="0" Width="80" Height="30" Text="Inscriptos" Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HAprobados" Left="570" Top="0" Width="80" Height="30" Text="Aprobados" Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HRegulares" Left="650" Top="0" Width="80" Height="30" Text="Regulares" Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HSinNota" Left="730" Top="0" Width="60" Height="30" Text="Sin nota" Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HPromedio" Left="790" Top="0" Width="50" Height="30" Text="Prom." Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
    </DataHeaderBand>
    <DataBand Name="DataResumen" Top="484" Width="840" Height="36" DataSourceName="Rendimiento">
      <TextObject Name="VMateria" Left="0" Top="0" Width="210" Height="36" Text="[Rendimiento.Materia]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VComision" Left="210" Top="0" Width="95" Height="36" Text="[Rendimiento.Comision]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VAnio" Left="305" Top="0" Width="60" Height="36" Text="[Rendimiento.Anio]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VCargo" Left="365" Top="0" Width="125" Height="36" Text="[Rendimiento.CargoTexto]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VInscriptos" Left="490" Top="0" Width="80" Height="36" Text="[Rendimiento.Inscriptos]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VAprobados" Left="570" Top="0" Width="80" Height="36" Text="[Rendimiento.Aprobados]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VRegulares" Left="650" Top="0" Width="80" Height="36" Text="[Rendimiento.Regulares]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VSinNota" Left="730" Top="0" Width="60" Height="36" Text="[Rendimiento.SinNota]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VPromedio" Left="790" Top="0" Width="50" Height="36" Text="[Rendimiento.PromedioTexto]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
    </DataBand>
  </ReportPage>
</Report>
