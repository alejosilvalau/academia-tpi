<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" TextQuality="Regular" ReportInfo.Description="Reporte de rendimiento del docente por notas de sus alumnos" ReportInfo.Created="08/19/2026" ReportInfo.CreatorVersion="2026.2.3.0">
  <Dictionary>
    <Parameter Name="DocenteNombre" DataType="System.String"/>
    <Parameter Name="DocenteLegajo" DataType="System.String"/>
    <Parameter Name="FechaGeneracion" DataType="System.String"/>
    <TableDataSource Name="Rendimiento" ReferenceName="Rendimiento" DataType="System.Int32" Enabled="true">
      <Column Name="Materia" DataType="System.String"/>
      <Column Name="Comision" DataType="System.String"/>
      <Column Name="Anio" DataType="System.Int32"/>
      <Column Name="CargoTexto" DataType="System.String"/>
      <Column Name="Inscriptos" DataType="System.Int32"/>
      <Column Name="Aprobados" DataType="System.Int32"/>
      <Column Name="Regulares" DataType="System.Int32"/>
      <Column Name="SinNota" DataType="System.Int32"/>
      <Column Name="PromedioTexto" DataType="System.String"/>
    </TableDataSource>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="210" PaperHeight="297" LeftMargin="25" RightMargin="25" TopMargin="25" BottomMargin="25">
    <ReportTitleBand Name="ReportTitle1" Width="596" Height="570">
      <TextObject Name="Title" Left="0" Top="20" Width="596" Height="36" Text="Reporte de Rendimiento Docente" HorzAlign="Center" Font="Segoe UI, 18pt, style=Bold" TextFill.Color="CornflowerBlue"/>
      <TextObject Name="SubTituloNombre" Left="0" Top="70" Width="596" Height="22" Text="Docente: [DocenteNombre] - Legajo: [DocenteLegajo]" HorzAlign="Center" Font="Segoe UI, 11pt, style=Bold"/>
      <TextObject Name="SubTituloFecha" Left="0" Top="100" Width="596" Height="16" Text="Generado: [FechaGeneracion]" HorzAlign="Center" Font="Segoe UI, 9pt" TextFill.Color="Gray"/>
      <PictureObject Name="GraficoGeneral" Left="48" Top="130" Width="500" Height="400" ImageFormat="Png"/>
      <TextObject Name="SubtituloTabla" Left="0" Top="544" Width="596" Height="24" Text="Rendimiento por curso" HorzAlign="Center" Font="Segoe UI, 11pt, style=Bold"/>
    </ReportTitleBand>
    <DataHeaderBand Name="HeaderResumen" Top="574" Width="596" Height="30">
      <TextObject Name="HMateria" Left="0" Top="0" Width="150" Height="30" Text="Materia" Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HComision" Left="150" Top="0" Width="65" Height="30" Text="Comisión" Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HAnio" Left="215" Top="0" Width="45" Height="30" Text="Año" HorzAlign="Center" Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HCargo" Left="260" Top="0" Width="90" Height="30" Text="Cargo" Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HInscriptos" Left="350" Top="0" Width="45" Height="30" Text="Inscr." Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HAprobados" Left="395" Top="0" Width="45" Height="30" Text="Aprob." Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HRegulares" Left="440" Top="0" Width="45" Height="30" Text="Reg." Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HSinNota" Left="485" Top="0" Width="45" Height="30" Text="S/n" Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HPromedio" Left="530" Top="0" Width="66" Height="30" Text="Promedio" Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
    </DataHeaderBand>
    <DataBand Name="DataResumen" Top="604" Width="596" Height="30" DataSourceName="Rendimiento">
      <TextObject Name="VMateria" Left="0" Top="0" Width="150" Height="30" Text="[Rendimiento.Materia]" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VComision" Left="150" Top="0" Width="65" Height="30" Text="[Rendimiento.Comision]" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VAnio" Left="215" Top="0" Width="45" Height="30" Text="[Rendimiento.Anio]" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VCargo" Left="260" Top="0" Width="90" Height="30" Text="[Rendimiento.CargoTexto]" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VInscriptos" Left="350" Top="0" Width="45" Height="30" Text="[Rendimiento.Inscriptos]" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VAprobados" Left="395" Top="0" Width="45" Height="30" Text="[Rendimiento.Aprobados]" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VRegulares" Left="440" Top="0" Width="45" Height="30" Text="[Rendimiento.Regulares]" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VSinNota" Left="485" Top="0" Width="45" Height="30" Text="[Rendimiento.SinNota]" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VPromedio" Left="530" Top="0" Width="66" Height="30" Text="[Rendimiento.PromedioTexto]" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
    </DataBand>
  </ReportPage>
</Report>
