<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" TextQuality="Regular" ReportInfo.Description="Reporte de rendimiento del docente por notas de sus alumnos" ReportInfo.Created="08/19/2026" ReportInfo.CreatorVersion="2026.2.3.0">
  <Dictionary>
    <Parameter Name="DocenteNombre" DataType="System.String"/>
    <Parameter Name="DocenteLegajo" DataType="System.String"/>
    <Parameter Name="FechaGeneracion" DataType="System.String"/>
    <TableDataSource Name="Rendimiento" ReferenceName="Rendimiento" DataType="System.Int32" Enabled="true">
      <Column Name="Materia" DataType="System.String"/>
      <Column Name="Comision" DataType="System.String"/>
      <Column Name="Anio" DataType="System.Int32"/>
      <Column Name="CargoTexto" DataType="System.String"/>
      <Column Name="Inscriptos" DataType="System.Int32"/>
      <Column Name="Aprobados" DataType="System.Int32"/>
      <Column Name="Regulares" DataType="System.Int32"/>
      <Column Name="SinNota" DataType="System.Int32"/>
      <Column Name="PromedioTexto" DataType="System.String"/>
    </TableDataSource>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="297" PaperHeight="210" LeftMargin="20" RightMargin="20" TopMargin="15" BottomMargin="15">
    <ReportTitleBand Name="ReportTitle1" Width="1040" Height="90">
      <TextObject Name="Title" Left="0" Top="0" Width="1040" Height="38" Text="Reporte de Rendimiento Docente" HorzAlign="Center" Font="Segoe UI, 20pt, style=Bold" TextFill.Color="CornflowerBlue"/>
      <TextObject Name="SubTituloNombre" Left="0" Top="42" Width="1040" Height="22" Text="Docente: [DocenteNombre] - Legajo: [DocenteLegajo]" HorzAlign="Center" Font="Segoe UI, 11pt, style=Bold"/>
      <TextObject Name="SubTituloFecha" Left="0" Top="66" Width="1040" Height="14" Text="Generado: [FechaGeneracion]" HorzAlign="Center" Font="Segoe UI, 9pt" TextFill.Color="Gray"/>
    </ReportTitleBand>
    <DataHeaderBand Name="HeaderResumen" Top="94" Width="1040" Height="30">
      <TextObject Name="HMateria" Left="0" Top="0" Width="240" Height="30" Text="Materia" Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HComision" Left="240" Top="0" Width="110" Height="30" Text="Comisión" Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HAnio" Left="350" Top="0" Width="70" Height="30" Text="Año" HorzAlign="Center" Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HCargo" Left="420" Top="0" Width="140" Height="30" Text="Cargo" Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HInscriptos" Left="560" Top="0" Width="90" Height="30" Text="Inscriptos" Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HAprobados" Left="650" Top="0" Width="90" Height="30" Text="Aprobados" Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HRegulares" Left="740" Top="0" Width="90" Height="30" Text="Regulares" Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HSinNota" Left="830" Top="0" Width="90" Height="30" Text="Sin nota" Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HPromedio" Left="920" Top="0" Width="120" Height="30" Text="Promedio" Font="Segoe UI, 10pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
    </DataHeaderBand>
    <DataBand Name="DataResumen" Top="124" Width="1040" Height="36" DataSourceName="Rendimiento">
      <TextObject Name="VMateria" Left="0" Top="0" Width="240" Height="36" Text="[Rendimiento.Materia]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center" TextFill.Color="Black"/>
      <TextObject Name="VComision" Left="240" Top="0" Width="110" Height="36" Text="[Rendimiento.Comision]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VAnio" Left="350" Top="0" Width="70" Height="36" Text="[Rendimiento.Anio]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VCargo" Left="420" Top="0" Width="140" Height="36" Text="[Rendimiento.CargoTexto]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VInscriptos" Left="560" Top="0" Width="90" Height="36" Text="[Rendimiento.Inscriptos]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VAprobados" Left="650" Top="0" Width="90" Height="36" Text="[Rendimiento.Aprobados]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VRegulares" Left="740" Top="0" Width="90" Height="36" Text="[Rendimiento.Regulares]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VSinNota" Left="830" Top="0" Width="90" Height="36" Text="[Rendimiento.SinNota]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VPromedio" Left="920" Top="0" Width="120" Height="36" Text="[Rendimiento.PromedioTexto]" Font="Segoe UI, 10pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
    </DataBand>
    <ReportSummaryBand Name="Summary1" Top="164" Width="1040" Height="300">
      <TextObject Name="LblGrafico" Left="0" Top="14" Width="1040" Height="22" Text="Gráfico de rendimiento por curso" HorzAlign="Center" Font="Segoe UI, 13pt, style=Bold"/>
      <PictureObject Name="GraficoGeneral" Left="160" Top="42" Width="720" Height="250" ImageFormat="Png"/>
    </ReportSummaryBand>
  </ReportPage>
</Report>
