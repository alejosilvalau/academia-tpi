<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" TextQuality="Regular" DoublePass="true" ReportInfo.Description="Reporte de rendimiento del docente" ReportInfo.Created="08/19/2026" ReportInfo.CreatorVersion="2026.2.3.0">
  <Dictionary>
    <Parameter Name="DocenteNombre" DataType="System.String"/>
    <Parameter Name="DocenteLegajo" DataType="System.String"/>
    <Parameter Name="FechaGeneracion" DataType="System.String"/>
    <TableDataSource Name="Rendimiento" ReferenceName="Rendimiento" DataType="System.Int32" Enabled="true">
      <Column Name="Materia" DataType="System.String"/>
      <Column Name="Comision" DataType="System.String"/>
      <Column Name="Anio" DataType="System.Int32"/>
      <Column Name="CargoTexto" DataType="System.String"/>
      <Column Name="Inscriptos" DataType="System.Int32"/>
      <Column Name="Aprobados" DataType="System.Int32"/>
      <Column Name="Regulares" DataType="System.Int32"/>
      <Column Name="SinNota" DataType="System.Int32"/>
      <Column Name="PromedioTexto" DataType="System.String"/>
    </TableDataSource>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="210" PaperHeight="297" LeftMargin="20" RightMargin="20" TopMargin="15" BottomMargin="15">
    <ReportTitleBand Name="ReportTitle1" Width="636" Height="410">
      <TextObject Name="Title" Left="0" Top="10" Width="636" Height="32" Text="Reporte de Rendimiento Docente" HorzAlign="Center" Font="Segoe UI, 18pt, style=Bold" TextFill.Color="CornflowerBlue"/>
      <TextObject Name="SubTituloNombre" Left="0" Top="46" Width="636" Height="18" Text="Docente: [DocenteNombre] - Legajo: [DocenteLegajo]" HorzAlign="Center" Font="Segoe UI, 10pt, style=Bold"/>
      <TextObject Name="SubTituloFecha" Left="0" Top="68" Width="636" Height="14" Text="Generado: [FechaGeneracion]" HorzAlign="Center" Font="Segoe UI, 8pt" TextFill.Color="Gray"/>
      <PictureObject Name="GraficoGeneral" Left="68" Top="90" Width="500" Height="280" ImageFormat="Png"/>
      <TextObject Name="SubtituloTabla" Left="0" Top="382" Width="636" Height="18" Text="Rendimiento por curso" HorzAlign="Center" Font="Segoe UI, 10pt, style=Bold"/>
    </ReportTitleBand>
    <ColumnHeaderBand Name="HeaderResumen" Width="636" Height="28">
      <TextObject Name="HMateria" Left="0" Top="0" Width="150" Height="28" Text="Materia" WordWrap="false" Font="Segoe UI, 7pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HComision" Left="150" Top="0" Width="70" Height="28" Text="Comisión" WordWrap="false" Font="Segoe UI, 7pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HAnio" Left="220" Top="0" Width="45" Height="28" Text="Año" WordWrap="false" Font="Segoe UI, 7pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HCargo" Left="265" Top="0" Width="115" Height="28" Text="Cargo" WordWrap="false" Font="Segoe UI, 7pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HInscriptos" Left="380" Top="0" Width="42" Height="28" Text="Insc." WordWrap="false" Font="Segoe UI, 7pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HAprobados" Left="422" Top="0" Width="42" Height="28" Text="Aprob." WordWrap="false" Font="Segoe UI, 7pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HRegulares" Left="464" Top="0" Width="42" Height="28" Text="Reg." WordWrap="false" Font="Segoe UI, 7pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HSinNota" Left="506" Top="0" Width="42" Height="28" Text="S/n" WordWrap="false" Font="Segoe UI, 7pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HPromedio" Left="548" Top="0" Width="88" Height="28" Text="Promedio" WordWrap="false" Font="Segoe UI, 7pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
    </ColumnHeaderBand>
    <DataBand Name="DataResumen" Width="636" Height="24" DataSourceName="Rendimiento">
      <TextObject Name="VMateria" Left="0" Top="0" Width="150" Height="24" Text="[Rendimiento.Materia]" Font="Segoe UI, 7pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VComision" Left="150" Top="0" Width="70" Height="24" Text="[Rendimiento.Comision]" Font="Segoe UI, 7pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VAnio" Left="220" Top="0" Width="45" Height="24" Text="[Rendimiento.Anio]" Font="Segoe UI, 7pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VCargo" Left="265" Top="0" Width="115" Height="24" Text="[Rendimiento.CargoTexto]" WordWrap="true" Font="Segoe UI, 7pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VInscriptos" Left="380" Top="0" Width="42" Height="24" Text="[Rendimiento.Inscriptos]" Font="Segoe UI, 7pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VAprobados" Left="422" Top="0" Width="42" Height="24" Text="[Rendimiento.Aprobados]" Font="Segoe UI, 7pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VRegulares" Left="464" Top="0" Width="42" Height="24" Text="[Rendimiento.Regulares]" Font="Segoe UI, 7pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VSinNota" Left="506" Top="0" Width="42" Height="24" Text="[Rendimiento.SinNota]" Font="Segoe UI, 7pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="VPromedio" Left="548" Top="0" Width="88" Height="24" Text="[Rendimiento.PromedioTexto]" Font="Segoe UI, 7pt" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
    </DataBand>
    <PageFooterBand Name="PageFooter1" Width="636" Height="20">
      <TextObject Name="NumeroPagina" Left="436" Top="0" Width="200" Height="20" Text="[Page] / [TotalPages]" HorzAlign="Right" Font="Segoe UI, 8pt" TextFill.Color="Gray"/>
    </PageFooterBand>
  </ReportPage>
</Report>
