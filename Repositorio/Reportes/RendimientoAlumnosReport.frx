<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" TextQuality="Regular" ReportInfo.Description="Reporte de rendimiento de alumnos por notas" ReportInfo.Created="08/19/2026" ReportInfo.CreatorVersion="2026.2.3.0">
  <Dictionary>
    <Parameter Name="TituloFiltro" DataType="System.String"/>
    <Parameter Name="FechaGeneracion" DataType="System.String"/>
    <TableDataSource Name="Alumnos" ReferenceName="Alumnos" DataType="System.Int32" Enabled="true">
      <Column Name="AlumnoId" DataType="System.Int32"/>
      <Column Name="Nombre" DataType="System.String"/>
      <Column Name="Apellido" DataType="System.String"/>
      <Column Name="Legajo" DataType="System.Int32"/>
      <Column Name="Materia" DataType="System.String"/>
      <Column Name="Comision" DataType="System.String"/>
      <Column Name="Anio" DataType="System.Int32"/>
      <Column Name="Nota" DataType="System.Int32"/>
      <Column Name="Condicion" DataType="System.Int32"/>
      <Column Name="CondicionTexto" DataType="System.String"/>
      <Column Name="NotaTexto" DataType="System.String"/>
    </TableDataSource>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="210" PaperHeight="297" LeftMargin="25" RightMargin="25" TopMargin="25" BottomMargin="25">
    <ReportTitleBand Name="ReportTitle1" Width="596" Height="570">
      <TextObject Name="Title" Left="0" Top="20" Width="596" Height="36" Text="Reporte de Rendimiento de Alumnos" HorzAlign="Center" Font="Segoe UI, 18pt, style=Bold" TextFill.Color="CornflowerBlue"/>
      <TextObject Name="SubTituloFiltro" Left="0" Top="70" Width="596" Height="22" Text="[TituloFiltro]" HorzAlign="Center" Font="Segoe UI, 11pt, style=Bold"/>
      <TextObject Name="SubTituloFecha" Left="0" Top="100" Width="596" Height="16" Text="Generado: [FechaGeneracion]" HorzAlign="Center" Font="Segoe UI, 9pt" TextFill.Color="Gray"/>
      <PictureObject Name="GraficoGeneral" Left="48" Top="130" Width="500" Height="400" ImageFormat="Png"/>
      <TextObject Name="SubtituloTabla" Left="0" Top="544" Width="596" Height="24" Text="Detalle de inscripciones" HorzAlign="Center" Font="Segoe UI, 11pt, style=Bold"/>
    </ReportTitleBand>
    <DataHeaderBand Name="HeaderDetalle" Top="574" Width="596" Height="30">
      <TextObject Name="HMateria2" Left="0" Top="0" Width="150" Height="30" Text="Materia" Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HComision2" Left="150" Top="0" Width="75" Height="30" Text="Comisión" Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HAnio2" Left="225" Top="0" Width="50" Height="30" Text="Año" HorzAlign="Center" Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HNota2" Left="275" Top="0" Width="60" Height="30" Text="Nota" HorzAlign="Center" Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HCondicion2" Left="335" Top="0" Width="261" Height="30" Text="Condición" Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
    </DataHeaderBand>
    <DataBand Name="DataDetalle" Top="604" Width="596" Height="30" DataSourceName="Alumnos">
      <TextObject Name="VMateria2" Left="0" Top="0" Width="150" Height="30" Text="[Alumnos.Materia]" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VComision2" Left="150" Top="0" Width="75" Height="30" Text="[Alumnos.Comision]" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VAnio2" Left="225" Top="0" Width="50" Height="30" Text="[Alumnos.Anio]" HorzAlign="Center" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VNota2" Left="275" Top="0" Width="60" Height="30" Text="[Alumnos.NotaTexto]" HorzAlign="Center" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VCondicion2" Left="335" Top="0" Width="261" Height="30" Text="[Alumnos.CondicionTexto]" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center"/>
    </DataBand>
  </ReportPage>
</Report>
