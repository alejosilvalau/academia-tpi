<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" TextQuality="Regular" ReportInfo.Description="Reporte de rendimiento de alumnos por notas" ReportInfo.Created="08/19/2026" ReportInfo.CreatorVersion="2026.2.3.0">
  <Dictionary>
    <Parameter Name="TituloFiltro" DataType="System.String"/>
    <Parameter Name="FechaGeneracion" DataType="System.String"/>
    <TableDataSource Name="Alumnos" ReferenceName="Alumnos" DataType="System.Int32" Enabled="true">
      <Column Name="AlumnoId" DataType="System.Int32"/>
      <Column Name="Nombre" DataType="System.String"/>
      <Column Name="Apellido" DataType="System.String"/>
      <Column Name="Legajo" DataType="System.Int32"/>
      <Column Name="Materia" DataType="System.String"/>
      <Column Name="Comision" DataType="System.String"/>
      <Column Name="Anio" DataType="System.Int32"/>
      <Column Name="Nota" DataType="System.Int32"/>
      <Column Name="Condicion" DataType="System.Int32"/>
      <Column Name="CondicionTexto" DataType="System.String"/>
      <Column Name="NotaTexto" DataType="System.String"/>
    </TableDataSource>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="210" PaperHeight="297" LeftMargin="30" RightMargin="30" TopMargin="12" BottomMargin="12">
    <ReportTitleBand Name="ReportTitle1" Width="632" Height="450">
      <TextObject Name="Title" Left="0" Top="0" Width="632" Height="34" Text="Reporte de Rendimiento de Alumnos" HorzAlign="Center" Font="Segoe UI, 18pt, style=Bold" TextFill.Color="CornflowerBlue"/>
      <TextObject Name="SubTituloFiltro" Left="0" Top="38" Width="632" Height="18" Text="[TituloFiltro]" HorzAlign="Center" Font="Segoe UI, 10pt, style=Bold"/>
      <TextObject Name="SubTituloFecha" Left="0" Top="58" Width="632" Height="14" Text="Generado: [FechaGeneracion]" HorzAlign="Center" Font="Segoe UI, 8pt" TextFill.Color="Gray"/>
      <PictureObject Name="GraficoGeneral" Left="18" Top="78" Width="596" Height="360" ImageFormat="Png"/>
    </ReportTitleBand>
    <GroupHeaderBand Name="GroupAlumno" Top="454" Width="632" Height="28" Condition="[Alumnos.AlumnoId]" SortOrder="Ascending">
      <TextObject Name="GrupoAlumno" Left="0" Top="0" Width="632" Height="28" Text="[Alumnos.Apellido], [Alumnos.Nombre]  -  Legajo: [Alumnos.Legajo]" Font="Segoe UI, 11pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
    </GroupHeaderBand>
    <DataHeaderBand Name="HeaderDetalle" Top="482" Width="632" Height="26">
      <TextObject Name="HMateria2" Left="0" Top="0" Width="180" Height="26" Text="Materia" Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HComision2" Left="180" Top="0" Width="95" Height="26" Text="Comisión" Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HAnio2" Left="275" Top="0" Width="55" Height="26" Text="Año" HorzAlign="Center" Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HNota2" Left="330" Top="0" Width="70" Height="26" Text="Nota" HorzAlign="Center" Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="HCondicion2" Left="400" Top="0" Width="232" Height="26" Text="Condición" Font="Segoe UI, 9pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center"/>
    </DataHeaderBand>
    <DataBand Name="DataDetalle" Top="508" Width="632" Height="28" DataSourceName="Alumnos">
      <TextObject Name="VMateria2" Left="0" Top="0" Width="180" Height="28" Text="[Alumnos.Materia]" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VComision2" Left="180" Top="0" Width="95" Height="28" Text="[Alumnos.Comision]" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VAnio2" Left="275" Top="0" Width="55" Height="28" Text="[Alumnos.Anio]" HorzAlign="Center" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VNota2" Left="330" Top="0" Width="70" Height="28" Text="[Alumnos.NotaTexto]" HorzAlign="Center" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VCondicion2" Left="400" Top="0" Width="232" Height="28" Text="[Alumnos.CondicionTexto]" Font="Segoe UI, 9pt" Border.Lines="All" VertAlign="Center"/>
    </DataBand>
  </ReportPage>
</Report>
