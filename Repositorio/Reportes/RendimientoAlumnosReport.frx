<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" TextQuality="Regular" ReportInfo.Description="Reporte de rendimiento de alumnos" ReportInfo.Created="08/19/2026" ReportInfo.CreatorVersion="2026.2.3.0">
  <Dictionary>
    <Parameter Name="TituloFiltro" DataType="System.String"/>
    <Parameter Name="FechaGeneracion" DataType="System.String"/>
    <TableDataSource Name="Alumnos" ReferenceName="Alumnos" DataType="System.Int32" Enabled="true">
      <Column Name="AlumnoId" DataType="System.Int32"/>
      <Column Name="Nombre" DataType="System.String"/>
      <Column Name="Apellido" DataType="System.String"/>
      <Column Name="Legajo" DataType="System.Int32"/>
      <Column Name="Materia" DataType="System.String"/>
      <Column Name="Comision" DataType="System.String"/>
      <Column Name="Anio" DataType="System.Int32"/>
      <Column Name="Nota" DataType="System.Int32"/>
      <Column Name="Condicion" DataType="System.Int32"/>
      <Column Name="CondicionTexto" DataType="System.String"/>
      <Column Name="NotaTexto" DataType="System.String"/>
    </TableDataSource>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="210" PaperHeight="297" LeftMargin="20" RightMargin="20" TopMargin="15" BottomMargin="15">
    <ReportTitleBand Name="ReportTitle1" Width="636" Height="400">
      <TextObject Name="Title" Left="0" Top="10" Width="636" Height="32" Text="Reporte de Rendimiento de Alumnos" HorzAlign="Center" Font="Segoe UI, 18pt, style=Bold" TextFill.Color="CornflowerBlue"/>
      <TextObject Name="SubTituloFiltro" Left="0" Top="46" Width="636" Height="18" Text="[TituloFiltro]" HorzAlign="Center" Font="Segoe UI, 10pt, style=Bold"/>
      <TextObject Name="SubTituloFecha" Left="0" Top="68" Width="636" Height="14" Text="Generado: [FechaGeneracion]" HorzAlign="Center" Font="Segoe UI, 8pt" TextFill.Color="Gray"/>
      <PictureObject Name="GraficoGeneral" Left="68" Top="90" Width="500" Height="280" ImageFormat="Png"/>
      <TextObject Name="SubtituloTabla" Left="0" Top="380" Width="636" Height="18" Text="Detalle de inscripciones" HorzAlign="Center" Font="Segoe UI, 10pt, style=Bold"/>
    </ReportTitleBand>
    <ColumnHeaderBand Name="HeaderDetalle" Width="636" Height="28">
      <TextObject Name="HMateria2" Left="0" Top="0" Width="180" Height="28" Text="Materia" WordWrap="false" Font="Segoe UI, 8pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HComision2" Left="180" Top="0" Width="80" Height="28" Text="Comisión" WordWrap="false" Font="Segoe UI, 8pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HAnio2" Left="260" Top="0" Width="50" Height="28" Text="Año" WordWrap="false" Font="Segoe UI, 8pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HNota2" Left="310" Top="0" Width="60" Height="28" Text="Nota" WordWrap="false" Font="Segoe UI, 8pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
      <TextObject Name="HCondicion2" Left="370" Top="0" Width="266" Height="28" Text="Condición" WordWrap="false" Font="Segoe UI, 8pt, style=Bold" Fill.Color="CornflowerBlue" TextFill.Color="White" Border.Lines="All" VertAlign="Center" HorzAlign="Center"/>
    </ColumnHeaderBand>
    <DataBand Name="DataDetalle" Width="636" Height="24" DataSourceName="Alumnos">
      <TextObject Name="VMateria2" Left="0" Top="0" Width="180" Height="28" Text="[Alumnos.Materia]" Font="Segoe UI, 8pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VComision2" Left="180" Top="0" Width="80" Height="28" Text="[Alumnos.Comision]" Font="Segoe UI, 8pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VAnio2" Left="260" Top="0" Width="50" Height="28" Text="[Alumnos.Anio]" HorzAlign="Center" Font="Segoe UI, 8pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VNota2" Left="310" Top="0" Width="60" Height="28" Text="[Alumnos.NotaTexto]" HorzAlign="Center" Font="Segoe UI, 8pt" Border.Lines="All" VertAlign="Center"/>
      <TextObject Name="VCondicion2" Left="370" Top="0" Width="266" Height="28" Text="[Alumnos.CondicionTexto]" Font="Segoe UI, 8pt" Border.Lines="All" VertAlign="Center"/>
    </DataBand>
  </ReportPage>
</Report>
