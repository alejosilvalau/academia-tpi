@inject IJSRuntime JS

@if (!string.IsNullOrEmpty(Mensaje))
{
    <div class="md-message @(EsError ? "md-message-error" : "md-message-success")">
        <span>@Mensaje</span>
        <button type="button" class="md-message-close" @onclick="Cerrar" aria-label="Cerrar">&#10005;</button>
    </div>
}

@code {
    [Parameter]
    public string? Mensaje { get; set; }

    [Parameter]
    public bool EsError { get; set; }

    [Parameter]
    public EventCallback Ocultar { get; set; }

    [Parameter]
    public double DuracionSegundos { get; set; } = 1.5;

    [Parameter]
    public int Version { get; set; }

    private System.Threading.Timer? _timer;
    private bool _scrollPendiente;
    private string? _ultimoMensaje;
    private int _ultimaVersion;

    protected override void OnParametersSet()
    {
        bool nuevo = false;
        if (!string.IsNullOrEmpty(Mensaje))
        {
            if (Version != 0 && Version != _ultimaVersion)
                nuevo = true;
            else if (Version == 0 && Mensaje != _ultimoMensaje)
                nuevo = true;
        }

        if (string.IsNullOrEmpty(Mensaje))
        {
            _timer?.Dispose();
            _timer = null;
        }
        else if (nuevo)
        {
            _timer?.Dispose();
            _timer = null;
            _timer = new System.Threading.Timer(
                _ => OcultarDesdeTimer(),
                null,
                TimeSpan.FromSeconds(DuracionSegundos),
                Timeout.InfiniteTimeSpan);
            _scrollPendiente = true;
        }

        _ultimoMensaje = Mensaje;
        _ultimaVersion = Version;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollPendiente)
        {
            _scrollPendiente = false;
            try { await JS.InvokeVoidAsync("window.scrollTo", 0, 0); } catch { }
        }
    }

    private void Cerrar()
    {
        _timer?.Dispose();
        _timer = null;
        _ = InvokeAsync(async () =>
        {
            try { await Ocultar.InvokeAsync(); }
            catch { }
        });
    }

    private void OcultarDesdeTimer()
    {
        try
        {
            _ = InvokeAsync(async () =>
            {
                try { await Ocultar.InvokeAsync(); }
                catch { }
            });
        }
        catch { }
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
