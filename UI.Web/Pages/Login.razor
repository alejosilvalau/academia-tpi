@page "/login"
@inject UI.Web.Services.SesionService Sesion
@inject AuthClient Auth
@inject NavigationManager Nav
@using Utils

@if (!Sesion.IsLoggedIn)
{
    <div class="login-container">
        <div class="login-left">
            <div class="login-left-logo">ACADEMIA</div>
            <div class="login-left-subtitle">Sistema de Gestion Academica</div>
            <div class="login-left-desc">
                Administre especialidades, planes, comisiones, materias,
                cursos, inscripciones y reportes de la academia.
            </div>
        </div>
        <div class="login-right">
            <div class="login-card">
                <h2>Iniciar Sesion</h2>
                <p>Ingrese sus credenciales para acceder al sistema</p>

                @if (sesionExpirada)
                {
                    <div class="md-message md-message-info">La sesión expiró. Inicie sesión nuevamente.</div>
                }

                @if (!string.IsNullOrEmpty(mensaje))
                {
                    <div class="md-message md-message-error">@mensaje</div>
                }

                <EditForm Model="this" OnValidSubmit="IniciarSesion">
                    <div class="md-form-group">
                        <label class="md-label">Usuario</label>
                        <input class="md-input" type="text" @bind="nombreUsuario" placeholder="Nombre de usuario" autofocus />
                    </div>
                    <div class="md-form-group">
                        <label class="md-label">Clave</label>
                        <input class="md-input" type="password" @bind="clave" placeholder="Contrasena" />
                    </div>
                    <button class="md-btn md-btn-accent" type="submit" disabled="@cargando">
                        @if (cargando) { <span>Ingresando...</span> } else { <span>Ingresar</span> }
                    </button>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private string nombreUsuario = "";
    private string clave = "";
    private string mensaje = "";
    private bool cargando = false;
    private bool sesionExpirada;

    protected override void OnInitialized()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        sesionExpirada = string.Equals(query["sesion"], "expirada", StringComparison.OrdinalIgnoreCase);

        if (Sesion.IsLoggedIn)
        {
            Nav.NavigateTo("/");
        }
    }

    private async Task IniciarSesion()
    {
        mensaje = "";
        cargando = true;

        try
        {
            if (string.IsNullOrWhiteSpace(nombreUsuario) || string.IsNullOrWhiteSpace(clave))
            {
                mensaje = "Complete todos los campos para continuar.";
                cargando = false;
                return;
            }

            var respuesta = await Auth.LoginAsync(nombreUsuario, clave);
            Sesion.Iniciar(respuesta);
            Nav.NavigateTo("/");
        }
        catch (ApiException ex)
        {
            mensaje = ex.StatusCode == System.Net.HttpStatusCode.Unauthorized
                ? (string.IsNullOrWhiteSpace(ex.Message) ? "Usuario o clave incorrectos." : ex.Message)
                : "Error al iniciar sesion: " + ex.Message;
            cargando = false;
        }
        catch (Exception ex)
        {
            mensaje = "Error al iniciar sesion: " + ex.Message;
            cargando = false;
        }
    }
}
