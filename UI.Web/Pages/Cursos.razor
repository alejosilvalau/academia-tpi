@page "/cursos"
@attribute [Authorize(Roles="Administrador")]
@inject CursoClient Api
@inject MateriaClient MateriaApi
@inject ComisionClient ComisionApi
@inject UI.Web.Services.SesionService Sesion
@inject NavigationManager Navigation
@using Utils

<div class="md-card">
    <div class="md-card-header-actions">
        <span>Tabla de Cursos</span>
        <div class="md-btn-group">
            <button class="md-btn md-btn-accent" @onclick="Nuevo">+ Nuevo</button>
        </div>
    </div>

    <AutoRefresh OnTick="Cargar" />
    <MensajeFeedback Mensaje="@mensaje" EsError="mensajeEsError" Ocultar="OcultarMensaje" />

    @if (modoForm != ModoForm.Ninguno)
    {
        <div class="md-card" style="border:1px solid var(--border);">
            <div class="md-card-header">@(modoForm == ModoForm.Alta ? "Nuevo Curso" : "Editar Curso")</div>
            <EditForm Model="actual" OnValidSubmit="Guardar">
                <div class="md-form-row-3">
                    <div class="md-form-group">
                        <label class="md-label">Materia</label>
                        <select class="md-select" @bind="actual.MateriaId">
                            <option value="0">-- Seleccione --</option>
                            @if (materias != null)
                            {
                                @foreach (var m in materias)
                                {
                                    <option value="@m.Id">@Formato.ToTitleCase(m.Descripcion)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="md-form-group">
                        <label class="md-label">Comision</label>
                        <select class="md-select" @bind="actual.ComisionId">
                            <option value="0">-- Seleccione --</option>
                            @if (comisiones != null)
                            {
                                @foreach (var c in comisiones)
                                {
                                    <option value="@c.Id">@Formato.ToTitleCase(c.Descripcion)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="md-form-group">
                        <label class="md-label">Anio Calendario</label>
                        <input class="md-input" type="number" @bind="actual.AnioCalendario" />
                    </div>
                </div>
                <div class="md-form-row">
                    <div class="md-form-group">
                        <label class="md-label">Cupo</label>
                        <input class="md-input" type="number" @bind="actual.Cupo" />
                    </div>
                    <div class="md-form-group"></div>
                </div>
                <div class="md-form-actions">
                    <button class="md-btn md-btn-cancel" type="button" @onclick="Cancelar">Cancelar</button>
                    <button class="md-btn md-btn-primary" type="submit">Guardar</button>
                </div>
            </EditForm>
        </div>
    }

    @if (lista == null)
    {
        <div class="md-loading"><div class="md-spinner"></div><p>Cargando...</p></div>
    }
    else if (lista.Count == 0)
    {
        <div class="md-empty"><div class="md-empty-icon">&#9830;</div><p>No hay cursos registrados</p></div>
    }
    else
    {
        <table class="md-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Materia</th>
                    <th>Comision</th>
                    <th>Anio</th>
                    <th>Cupo</th>
                    <th style="width:120px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr class="@(seleccionadaId == item.Id ? "selected" : "")" @onclick="() => Seleccionar(item.Id)">
                        <td>@item.Id</td>
                        <td>@Formato.ToTitleCase(item.MateriaDescripcion ?? "")</td>
                        <td>@Formato.ToTitleCase(item.ComisionDescripcion ?? "")</td>
                        <td>@item.AnioCalendario</td>
                        <td>@item.Cupo</td>
                        <td class="md-table-actions">
                            <button class="md-btn md-btn-primary md-btn-sm" @onclick="() => Editar(item.Id)">Editar</button>
                            <button class="md-btn md-btn-danger md-btn-sm" @onclick="() => Eliminar(item.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<CursoDto>? lista;
    private List<MateriaDto>? materias;
    private List<ComisionDto>? comisiones;
    private CursoRequest actual = new();
    private ModoForm modoForm = ModoForm.Ninguno;
    private int seleccionadaId;
    private string mensaje = "";
    private bool mensajeEsError = false;

    enum ModoForm { Ninguno, Alta, Modificacion }

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.ValidarPermisos(TipoPersona.Administrador))
        {
            Navigation.NavigateTo("/");
            return;
        }
        try
        {
            materias = await MateriaApi.GetAllAsync();
            comisiones = await ComisionApi.GetAllAsync();
        }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
        await Cargar();
    }

    private async Task Cargar()
    {
        try { lista = await Api.GetAllAsync(); }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private void Seleccionar(int id) => seleccionadaId = id;

    private void Nuevo()
    {
        actual = new CursoRequest { AnioCalendario = DateTime.Now.Year };
        modoForm = ModoForm.Alta;
        seleccionadaId = 0;
    }

    private async Task Editar(int id)
    {
        var item = await Api.GetOneAsync(id);
        if (item == null) return;
        actual = new CursoRequest
        {
            AnioCalendario = item.AnioCalendario,
            Cupo = item.Cupo,
            MateriaId = item.MateriaId,
            ComisionId = item.ComisionId
        };
        modoForm = ModoForm.Modificacion;
        seleccionadaId = id;
    }

    private void Cancelar()
    {
        modoForm = ModoForm.Ninguno;
        actual = new CursoRequest();
    }

    private async Task Guardar()
    {
        try
        {
            Validaciones.AsegurarPositivo(actual.AnioCalendario, "Anio Calendario");
            Validaciones.AsegurarPositivo(actual.Cupo, "Cupo");
            if (actual.MateriaId == 0) { mostrarMensaje("Seleccione una materia.", true); return; }
            if (actual.ComisionId == 0) { mostrarMensaje("Seleccione una comision.", true); return; }
            if (modoForm == ModoForm.Alta)
                await Api.SaveAsync(actual);
            else
                await Api.UpdateAsync(seleccionadaId, actual);

            mostrarMensaje("Guardado correctamente.", false);
            Cancelar();
            await Cargar();
        }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private async Task Eliminar(int id)
    {
        try
        {
            await Api.DeleteAsync(id);
            mostrarMensaje("Eliminado correctamente.", false);
            await Cargar();
        }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private void mostrarMensaje(string msg, bool esError)
    {
        mensaje = msg;
        mensajeEsError = esError;
    }

    private void OcultarMensaje()
    {
        mensaje = "";
    }
}
