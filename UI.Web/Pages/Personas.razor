@page "/personas"
@attribute [Authorize(Roles="Administrador")]
@inject PersonaServicio PersonaServicio
@inject PlanServicio PlanServicio
@inject UI.Web.Services.SesionService Sesion
@inject NavigationManager Navigation

<div class="md-card">
    <div class="md-card-header-actions">
        <span>@Titulo</span>
        @if (!modoSeleccion)
        {
            <div class="md-btn-group">
                <button class="md-btn md-btn-accent" @onclick="Nuevo">+ Nueva</button>
            </div>
        }
    </div>

    <AutoRefresh OnTick="Cargar" />
    <MensajeFeedback Mensaje="@mensaje" EsError="mensajeEsError" Ocultar="OcultarMensaje" />

    @if (!modoSeleccion && modoForm != ModoForm.Ninguno)
    {
        <div class="md-card" style="border:1px solid var(--border);">
            <div class="md-card-header">@(modoForm == ModoForm.Alta ? "Nueva Persona" : "Editar Persona")</div>
            <EditForm Model="actual" OnValidSubmit="Guardar">
                <div class="md-form-row">
                    <div class="md-form-group">
                        <label class="md-label">Nombre</label>
                        <input class="md-input" @bind="actual.Nombre" />
                    </div>
                    <div class="md-form-group">
                        <label class="md-label">Apellido</label>
                        <input class="md-input" @bind="actual.Apellido" />
                    </div>
                </div>
                <div class="md-form-row-3">
                    <div class="md-form-group">
                        <label class="md-label">Legajo</label>
                        <input class="md-input" type="number" @bind="actual.Legajo" />
                    </div>
                    <div class="md-form-group">
                        <label class="md-label">Tipo</label>
                        <select class="md-select" @bind="tipoSeleccionado">
                            <option value="0">Administrador</option>
                            <option value="1">Alumno</option>
                            <option value="2">Docente</option>
                        </select>
                    </div>
                    <div class="md-form-group">
                        <label class="md-label">Fecha Nacimiento</label>
                        <input class="md-input" type="date" @bind="fechaNac" />
                    </div>
                </div>
                <div class="md-form-row">
                    <div class="md-form-group">
                        <label class="md-label">Email</label>
                        <input class="md-input" type="email" @bind="actual.EMail" />
                    </div>
                    <div class="md-form-group">
                        <label class="md-label">Telefono</label>
                        <input class="md-input" @bind="actual.Telefono" />
                    </div>
                </div>
                <div class="md-form-row">
                    <div class="md-form-group">
                        <label class="md-label">Direccion</label>
                        <input class="md-input" @bind="actual.Direccion" />
                    </div>
                    <div class="md-form-group">
                        <label class="md-label">Plan</label>
                        <select class="md-select" @bind="planIdSeleccionado">
                            <option value="">-- Ninguno --</option>
                            @if (planes != null)
                            {
                                @foreach (var p in planes)
                                {
                                    <option value="@p.ID">@p.Descripcion</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="md-form-actions">
                    <button class="md-btn md-btn-cancel" type="button" @onclick="Cancelar">Cancelar</button>
                    <button class="md-btn md-btn-primary" type="submit">Guardar</button>
                </div>
            </EditForm>
        </div>
    }

    @if (lista == null)
    {
        <div class="md-loading"><div class="md-spinner"></div><p>Cargando...</p></div>
    }
    else if (lista.Count == 0)
    {
        <div class="md-empty"><div class="md-empty-icon">&#9830;</div><p>No hay personas registradas</p></div>
    }
    else
    {
        <table class="md-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Legajo</th>
                    <th>Tipo</th>
                    <th>Email</th>
                    <th style="width:120px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr class="@(seleccionadaId == item.ID ? "selected" : "")" @onclick="() => Seleccionar(item.ID)">
                        <td>@item.ID</td>
                        <td>@item.Nombre</td>
                        <td>@item.Apellido</td>
                        <td>@item.Legajo</td>
                        <td><span class="md-badge md-badge-primary">@item.Tipo</span></td>
                        <td>@item.EMail</td>
                        <td class="md-table-actions">
                            @if (modoSeleccion)
                            {
                                <button class="md-btn md-btn-accent md-btn-sm" @onclick="() => SeleccionarPersona(item.ID)">Seleccionar</button>
                            }
                            else
                            {
                                <button class="md-btn md-btn-primary md-btn-sm" @onclick="() => Editar(item.ID)">Editar</button>
                                <button class="md-btn md-btn-danger md-btn-sm" @onclick="() => Eliminar(item.ID)">Eliminar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Persona>? lista;
    private List<Plan>? planes;
    private Persona actual = new();
    private ModoForm modoForm = ModoForm.Ninguno;
    private int seleccionadaId;
    private string mensaje = "";
    private bool mensajeEsError = false;
    private string tipoSeleccionado = "1";
    private string? planIdSeleccionado;
    private DateTime fechaNac = DateTime.Now.AddYears(-20);

    [SupplyParameterFromQuery(Name = "tipo")]
    private string? TipoFiltro { get; set; }

    [SupplyParameterFromQuery(Name = "seleccion")]
    private string? Seleccion { get; set; }

    private bool modoSeleccion;
    private Persona.TiposPersonas? tipoSeleccion;
    private string Titulo
    {
        get
        {
            if (!modoSeleccion || !tipoSeleccion.HasValue) return "Personas";
            if (Seleccion?.Equals("inscripcion", StringComparison.OrdinalIgnoreCase) == true)
                return "Inscripciones";
            if (Seleccion?.Equals("notas", StringComparison.OrdinalIgnoreCase) == true)
                return "Registrar Notas";
            return $"Personas - {tipoSeleccion}";
        }
    }

    enum ModoForm { Ninguno, Alta, Modificacion }

    protected override void OnInitialized()
    {
        if (!Sesion.ValidarPermisos(Dominio.Persona.TiposPersonas.Administrador))
        {
            Navigation.NavigateTo("/");
            return;
        }

        planes = PlanServicio.GetAll();
    }

    protected override void OnParametersSet()
    {
        modoSeleccion = false;
        tipoSeleccion = null;

        if (!string.IsNullOrEmpty(TipoFiltro))
        {
            modoSeleccion = true;
            tipoSeleccion = TipoFiltro.Equals("alumno", StringComparison.OrdinalIgnoreCase)
                ? Persona.TiposPersonas.Alumno
                : Persona.TiposPersonas.Docente;
        }

        Cargar();
    }

    private void Cargar()
    {
        try
        {
            lista = modoSeleccion && tipoSeleccion.HasValue
                ? PersonaServicio.GetByTipo(tipoSeleccion.Value)
                : PersonaServicio.GetAll();
        }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private void SeleccionarPersona(int id)
    {
        if (Seleccion?.Equals("inscripcion", StringComparison.OrdinalIgnoreCase) == true)
            Navigation.NavigateTo($"/inscripciones/{id}");
        else if (Seleccion?.Equals("notas", StringComparison.OrdinalIgnoreCase) == true)
            Navigation.NavigateTo($"/registrar-notas/{id}");
    }

    private void Seleccionar(int id) => seleccionadaId = id;

    private void Nuevo()
    {
        actual = new Persona { FechaNacimiento = DateTime.Now.AddYears(-20) };
        fechaNac = DateTime.Now.AddYears(-20);
        tipoSeleccionado = "1";
        planIdSeleccionado = null;
        modoForm = ModoForm.Alta;
        seleccionadaId = 0;
    }

    private void Editar(int id)
    {
        var item = PersonaServicio.GetOne(id);
        if (item == null) return;
        actual = item;
        tipoSeleccionado = ((int)item.Tipo).ToString();
        planIdSeleccionado = item.PlanId?.ToString();
        fechaNac = item.FechaNacimiento;
        modoForm = ModoForm.Modificacion;
        seleccionadaId = id;
    }

    private void Cancelar()
    {
        modoForm = ModoForm.Ninguno;
        actual = new Persona();
    }

    private void Guardar()
    {
        try
        {
            actual.Tipo = (Persona.TiposPersonas)int.Parse(tipoSeleccionado);
            actual.FechaNacimiento = fechaNac;
            if (int.TryParse(planIdSeleccionado, out int pid))
                actual.PlanId = pid;
            else
                actual.PlanId = null;

            if (modoForm == ModoForm.Alta)
                PersonaServicio.Save(actual);
            else
                PersonaServicio.Update(actual);

            mostrarMensaje("Guardado correctamente.", false);
            Cancelar();
            Cargar();
        }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private void Eliminar(int id)
    {
        var item = PersonaServicio.GetOne(id);
        if (item == null) return;
        try
        {
            PersonaServicio.Delete(item);
            mostrarMensaje("Eliminado correctamente.", false);
            Cargar();
        }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private void mostrarMensaje(string msg, bool esError)
    {
        mensaje = msg;
        mensajeEsError = esError;
    }

    private void OcultarMensaje()
    {
        mensaje = "";
    }
}
