@page "/inscripciones"
@page "/inscripciones/{alumnoId:int}"
@attribute [Authorize(Roles="Administrador,Alumno")]
@inject InscripcionClient Api
@inject CursoClient CursoApi
@inject PersonaClient PersonaApi
@inject UI.Web.Services.SesionService Sesion
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Utils

<div class="md-card">
<div class="md-card-header-actions">
        <span>Tabla de Inscripciones @(esAdminConAlumno ? $"- {alumnoObjetivo}" : "")</span>
        <div class="md-btn-group">
            @if (Sesion.IsAdmin)
            {
                <button class="md-btn md-btn-accent" @onclick="Nuevo">+ Nueva</button>
            }
            else
            {
                <button class="md-btn md-btn-accent" @onclick="Nuevo">+ Inscribirme</button>
            }
        </div>
</div>

    <AutoRefresh OnTick="Cargar" />
    <MensajeFeedback Mensaje="@mensaje" EsError="mensajeEsError" Ocultar="OcultarMensaje" />

    @if (modoForm != ModoForm.Ninguno)
    {
        <div class="md-card" style="border:1px solid var(--border);">
            <div class="md-card-header">Nueva Inscripcion</div>
            <EditForm Model="solicitud" OnValidSubmit="Guardar">
                <div class="md-form-row">
                    <div class="md-form-group">
                        <label class="md-label">Alumno</label>
                        <input class="md-input" value="@NombreAlumnoFijo" disabled />
                    </div>
                    <div class="md-form-group">
                        <label class="md-label">Curso</label>
                        <select class="md-select" @bind="solicitud.CursoId">
                            <option value="0">-- Seleccione --</option>
                            @if (cursos != null)
                            {
                                @foreach (var c in cursos)
                                {
                                    <option value="@c.Id">@Formato.ToTitleCase(c.MateriaDescripcion) - @Formato.ToTitleCase(c.ComisionDescripcion) - @c.AnioCalendario</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="md-form-actions">
                    <button class="md-btn md-btn-cancel" type="button" @onclick="Cancelar">Cancelar</button>
                    <button class="md-btn md-btn-primary" type="submit">Inscribir</button>
                </div>
            </EditForm>
        </div>
    }

    @if (lista == null)
    {
        <div class="md-loading"><div class="md-spinner"></div><p>Cargando...</p></div>
    }
    else if (lista.Count == 0)
    {
        <div class="md-empty"><div class="md-empty-icon">&#9998;</div><p>No hay inscripciones registradas</p></div>
    }
    else
    {
        <table class="md-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Legajo</th>
                    <th>Alumno</th>
                    <th>Materia</th>
                    <th>Comision</th>
                    <th>Condicion</th>
                    <th>Nota</th>
                    <th style="width:80px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr class="@(seleccionadaId == item.Id ? "selected" : "")" @onclick="() => Seleccionar(item.Id)">
                        <td>@item.Id</td>
                        <td>@item.AlumnoLegajo</td>
                        <td>@Formato.ToTitleCase(item.AlumnoNombre ?? "") @Formato.ToTitleCase(item.AlumnoApellido ?? "")</td>
                        <td>@Formato.ToTitleCase(item.CursoMateriaDescripcion ?? "")</td>
                        <td>@Formato.ToTitleCase(item.CursoComisionDescripcion ?? "")</td>
                        <td><span class="md-badge md-badge-primary">@item.Condicion</span></td>
                        <td>@(item.Nota?.ToString() ?? "-")</td>
                        <td>
                            @if (Sesion.IsAdmin)
                            {
                                <button class="md-btn md-btn-danger md-btn-sm" @onclick="() => Eliminar(item.Id)">Baja</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter]
    public int? alumnoId { get; set; }

    private List<InscripcionDto>? lista;
    private List<CursoDto>? cursos;
    private InscribirRequest solicitud = new();
    private ModoForm modoForm = ModoForm.Ninguno;
    private int seleccionadaId;
    private string mensaje = "";
    private bool mensajeEsError = false;
    private int alumnoObjetivoId;
    private string alumnoObjetivo = "";
    private bool esAdminConAlumno => Sesion.IsAdmin && alumnoObjetivoId > 0;
    private string NombreAlumnoFijo => esAdminConAlumno
        ? alumnoObjetivo
        : $"{Formato.ToTitleCase(Sesion.Perfil?.Nombre ?? "")} {Formato.ToTitleCase(Sesion.Perfil?.Apellido ?? "")}";

    enum ModoForm { Ninguno, Alta }

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.ValidarPermisos(TipoPersona.Alumno))
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (Sesion.IsAdmin)
        {
            if (alumnoId == null || alumnoId.Value <= 0)
            {
                Navigation.NavigateTo("/personas?tipo=alumno&seleccion=inscripcion");
                return;
            }
            var alumno = await PersonaApi.GetBasicoAsync(alumnoId.Value);
            if (alumno == null)
            {
                Navigation.NavigateTo("/personas?tipo=alumno&seleccion=inscripcion");
                return;
            }
            alumnoObjetivoId = alumno.Id;
            alumnoObjetivo = $"{Formato.ToTitleCase(alumno.Nombre)} {Formato.ToTitleCase(alumno.Apellido)}";
        }
        else
        {
            alumnoObjetivoId = Sesion.PersonaId ?? 0;
        }

        solicitud = new InscribirRequest { AlumnoId = alumnoObjetivoId };

        try { cursos = await CursoApi.GetAllAsync(); }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }

        await Cargar();
    }

    private async Task Cargar()
    {
        try
        {
            if (alumnoObjetivoId > 0)
                lista = await Api.GetByAlumnoAsync(alumnoObjetivoId);
        }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private void Seleccionar(int id) => seleccionadaId = id;

    private void Nuevo()
    {
        solicitud = new InscribirRequest { AlumnoId = alumnoObjetivoId };
        modoForm = ModoForm.Alta;
    }

    private void Cancelar()
    {
        modoForm = ModoForm.Ninguno;
        solicitud = new InscribirRequest { AlumnoId = alumnoObjetivoId };
    }

    private async Task Guardar()
    {
        try
        {
            if (solicitud.CursoId == 0) { mostrarMensaje("Seleccione un curso.", true); return; }

            await Api.InscribirAsync(solicitud);
            mostrarMensaje("Inscripcion realizada correctamente.", false);
            Cancelar();
            await Cargar();
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private async Task Eliminar(int id)
    {
        try
        {
            await Api.DeleteAsync(id);
            mostrarMensaje("Inscripcion eliminada correctamente.", false);
            Cancelar();
            await Cargar();
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private void mostrarMensaje(string msg, bool esError)
    {
        mensaje = msg;
        mensajeEsError = esError;
    }

    private void OcultarMensaje()
    {
        mensaje = "";
    }
}
