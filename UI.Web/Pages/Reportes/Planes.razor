@page "/reportes/planes"
@inject ReporteServicio ReporteServicio
@inject UI.Web.Services.SesionService Sesion
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="md-card">
    <div class="md-card-header">Reporte de Planes</div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="md-message @(mensaje.Contains("Error") ? "md-message-error" : "md-message-success")">@mensaje</div>
    }

    <div class="md-form-row">
        <div class="md-form-group">
            <label class="md-label">Plan</label>
            <select class="md-select" @bind="planId">
                <option value="0">-- Seleccione un plan --</option>
                @if (planes != null)
                {
                    @foreach (DataRow row in planes.Rows)
                    {
                        <option value="@row["ID"]">@row["Descripcion"] - @row["Especialidad"]</option>
                    }
                }
            </select>
        </div>
        <div class="md-form-group" style="display:flex;align-items:flex-end;">
            <button class="md-btn md-btn-accent" @onclick="GenerarReporte" disabled="@(planId == 0)">
                Generar Reporte PDF
            </button>
        </div>
    </div>

    @if (planId != 0 && planes != null)
    {
        var selectedRow = planes.Select().FirstOrDefault(r => r["ID"].ToString() == planId.ToString());
        if (selectedRow != null)
        {
            <div class="md-card" style="border:1px solid var(--border);margin-top:16px;">
                <div class="md-card-header">Vista Previa</div>
                <table class="md-table">
                    <thead>
                        <tr>
                            <th>Descripcion</th>
                            <th>Especialidad</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@selectedRow["Descripcion"]</td>
                            <td>@selectedRow["Especialidad"]</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private DataTable? planes;
    private int planId;
    private string mensaje = string.Empty;

    protected override void OnInitialized()
    {
        if (!Sesion.ValidarPermisos(Dominio.Persona.TiposPersonas.Administrador))
        {
            Navigation.NavigateTo("/");
            return;
        }

        try
        {
            planes = ReporteServicio.ObtenerPlanes();
        }
        catch (Exception ex)
        {
            mensaje = "Error al cargar planes: " + ex.Message;
        }
    }

    private async Task GenerarReporte()
    {
        if (planId == 0)
        {
            mensaje = "Seleccione un plan.";
            return;
        }

        try
        {
            var report = ReporteServicio.GenerarReportePlanes(planId);
            byte[] pdfBytes = ReporteServicio.ExportarPdf(report);

            await JS.InvokeVoidAsync("downloadFile",
                $"ReportePlanes_{planId}.pdf",
                "application/pdf",
                Convert.ToBase64String(pdfBytes));

            mensaje = "Reporte generado correctamente.";
        }
        catch (Exception ex)
        {
            mensaje = "Error al generar reporte: " + ex.Message;
        }
    }
}
