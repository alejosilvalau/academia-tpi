@page "/reportes/cursos"
@inject ReporteServicio ReporteServicio
@inject UI.Web.Services.SesionService Sesion
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="md-card">
    <div class="md-card-header">Reporte de Cursos</div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="md-message @(mensaje.Contains("Error") ? "md-message-error" : "md-message-success")">@mensaje</div>
    }

    <div class="md-form-row">
        <div class="md-form-group">
            <label class="md-label">Curso</label>
            <select class="md-select" @bind="cursoId">
                <option value="0">-- Seleccione un curso --</option>
                @if (cursos != null)
                {
                    @foreach (DataRow row in cursos.Rows)
                    {
                        <option value="@row["ID"]">@row["Materia"] - @row["Comision"] (@row["AnioCalendario"])</option>
                    }
                }
            </select>
        </div>
        <div class="md-form-group" style="display:flex;align-items:flex-end;">
            <button class="md-btn md-btn-accent" @onclick="GenerarReporte" disabled="@(cursoId == 0)">
                Generar Reporte PDF
            </button>
        </div>
    </div>

    @if (cursoId != 0 && cursos != null)
    {
        var selectedRow = cursos.Select().FirstOrDefault(r => r["ID"].ToString() == cursoId.ToString());
        if (selectedRow != null)
        {
            <div class="md-card" style="border:1px solid var(--border);margin-top:16px;">
                <div class="md-card-header">Vista Previa</div>
                <table class="md-table">
                    <thead>
                        <tr>
                            <th>Materia</th>
                            <th>Comision</th>
                            <th>Anio</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@selectedRow["Materia"]</td>
                            <td>@selectedRow["Comision"]</td>
                            <td>@selectedRow["AnioCalendario"]</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private DataTable? cursos;
    private int cursoId;
    private string mensaje = string.Empty;

    protected override void OnInitialized()
    {
        if (!Sesion.ValidarPermisos(Dominio.Persona.TiposPersonas.Administrador))
        {
            Navigation.NavigateTo("/");
            return;
        }

        try
        {
            cursos = ReporteServicio.ObtenerCursos();
        }
        catch (Exception ex)
        {
            mensaje = "Error al cargar cursos: " + ex.Message;
        }
    }

    private async Task GenerarReporte()
    {
        if (cursoId == 0)
        {
            mensaje = "Seleccione un curso.";
            return;
        }

        try
        {
            var report = ReporteServicio.GenerarReporteCursos(cursoId);
            byte[] pdfBytes = ReporteServicio.ExportarPdf(report);

            await JS.InvokeVoidAsync("downloadFile",
                $"ReporteCursos_{cursoId}.pdf",
                "application/pdf",
                Convert.ToBase64String(pdfBytes));

            mensaje = "Reporte generado correctamente.";
        }
        catch (Exception ex)
        {
            mensaje = "Error al generar reporte: " + ex.Message;
        }
    }
}
