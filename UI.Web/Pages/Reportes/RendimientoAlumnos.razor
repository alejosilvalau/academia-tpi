@page "/reportes/rendimiento-alumnos"
@attribute [Authorize(Roles="Administrador,Docente,Alumno")]
@inject ReporteClient ReporteApi
@inject PersonaClient PersonaApi
@inject UI.Web.Services.SesionService Sesion
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="md-card">
    <div class="md-card-header">Reporte de Rendimiento de Alumnos</div>

    <MensajeFeedback Mensaje="@mensaje" EsError='@mensaje.Contains("Error")' Ocultar="OcultarMensaje" />

    <div class="md-form-row">
        @if (Sesion.IsAdmin || Sesion.IsDocente)
        {
            <div class="md-form-group">
                <label class="md-label">Alumno</label>
                <select class="md-select" @bind="alumnoId">
                    <option value="0">-- Seleccione un alumno --</option>
                    @if (alumnos != null)
                    {
                        @foreach (var a in alumnos)
                        {
                            <option value="@a.Id">@a.Etiqueta</option>
                        }
                    }
                </select>
            </div>
        }
        <div class="md-form-group" style="display:flex;align-items:flex-end;gap:8px;">
            <button class="md-btn md-btn-accent" @onclick="GenerarReporte" disabled="@(NecesitaSeleccion && alumnoId == 0)">
                Generar Reporte
            </button>
            <button class="md-btn" @onclick="DescargarPdf" disabled="@(pdfBase64 == null)">
                Descargar PDF
            </button>
        </div>
    </div>

    @if (pdfBase64 != null)
    {
        <div class="md-card" style="border:1px solid var(--border);margin-top:16px;padding:8px;">
            <iframe id="pdfFrame" style="width:100%;height:80vh;border:0;"></iframe>
        </div>
    }
</div>

@code {
    private List<ReportePersonaFilaDto>? alumnos;
    private int alumnoId;
    private string mensaje = string.Empty;
    private string? pdfBase64;
    private bool _cargarPdf;
    private ReportePersonaFilaDto? personaObjetivo;

    private bool NecesitaSeleccion => Sesion.IsAdmin || Sesion.IsDocente;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            if (Sesion.IsAdmin)
            {
                alumnos = await ReporteApi.GetAlumnosAsync();
            }
            else if (Sesion.IsDocente)
            {
                alumnos = await ReporteApi.GetAlumnosDeDocenteAsync(Sesion.PersonaId ?? 0);
            }
            else
            {
                await GenerarReporte();
            }
        }
        catch (Exception ex)
        {
            mensaje = "Error al cargar alumnos: " + ex.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_cargarPdf && pdfBase64 != null)
        {
            _cargarPdf = false;
            await JS.InvokeVoidAsync("setIframeSrc", "pdfFrame", pdfBase64, "application/pdf");
        }
    }

    private async Task GenerarReporte()
    {
        try
        {
            int personaId;

            if (NecesitaSeleccion)
            {
                if (alumnoId == 0)
                {
                    mensaje = "Seleccione un alumno.";
                    return;
                }
                personaId = alumnoId;
            }
            else
            {
                personaId = Sesion.PersonaId ?? 0;
            }

            byte[] pdfBytes = await ReporteApi.GetRendimientoAlumnoPdfAsync(personaId);
            pdfBase64 = Convert.ToBase64String(pdfBytes);

            personaObjetivo = alumnos?.FirstOrDefault(a => a.Id == personaId);
            if (personaObjetivo == null)
            {
                var p = await PersonaApi.GetBasicoAsync(personaId);
                if (p != null)
                    personaObjetivo = new ReportePersonaFilaDto(p.Id, p.Nombre, p.Apellido, p.Legajo);
            }

            _cargarPdf = true;
            StateHasChanged();
            mensaje = "Reporte generado correctamente.";
        }
        catch (Exception ex)
        {
            mensaje = "Error al generar reporte: " + ex.Message;
        }
    }

    private async Task DescargarPdf()
    {
        if (pdfBase64 == null) return;
        var persona = personaObjetivo;
        string nombreArchivo = persona != null
            ? $"reporte-rendimiento-alumno-{persona.Legajo}-{persona.Nombre}-{persona.Apellido}-{DateTime.Now:yyyyMMdd}"
            : $"reporte-rendimiento-alumno-{DateTime.Now:yyyyMMdd}";
        await JS.InvokeVoidAsync("downloadFile",
            $"{nombreArchivo}.pdf",
            "application/pdf",
            pdfBase64);
    }

    private void OcultarMensaje()
    {
        mensaje = string.Empty;
    }
}
