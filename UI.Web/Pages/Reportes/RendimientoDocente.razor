@page "/reportes/rendimiento-docente"
@attribute [Authorize(Roles="Administrador,Docente")]
@inject ReporteClient ReporteApi
@inject PersonaClient PersonaApi
@inject UI.Web.Services.SesionService Sesion
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="md-card">
    <div class="md-card-header">Reporte de Rendimiento Docente</div>

    <MensajeFeedback Mensaje="@mensaje" EsError='@mensaje.Contains("Error")' Ocultar="OcultarMensaje" />

    <div class="md-form-row">
        @if (Sesion.IsAdmin)
        {
            <div class="md-form-group">
                <label class="md-label">Docente</label>
                <select class="md-select" @bind="docenteId">
                    <option value="0">-- Seleccione un docente --</option>
                    @if (docentes != null)
                    {
                        @foreach (var d in docentes)
                        {
                            <option value="@d.Id">@d.Apellido, @d.Nombre (Legajo @d.Legajo)</option>
                        }
                    }
                </select>
            </div>
        }
        <div class="md-form-group" style="display:flex;align-items:flex-end;gap:8px;">
            <button class="md-btn md-btn-accent" @onclick="GenerarReporte" disabled="@(Sesion.IsAdmin && docenteId == 0)">
                Generar Reporte
            </button>
            <button class="md-btn" @onclick="DescargarPdf" disabled="@(pdfBase64 == null)">
                Descargar PDF
            </button>
        </div>
    </div>

    @if (pdfBase64 != null)
    {
        <div class="md-card" style="border:1px solid var(--border);margin-top:16px;padding:8px;">
            <iframe id="pdfFrame" style="width:100%;height:80vh;border:0;"></iframe>
        </div>
    }
</div>

@code {
    private List<ReportePersonaFilaDto>? docentes;
    private int docenteId;
    private string mensaje = string.Empty;
    private string? pdfBase64;
    private bool _cargarPdf;
    private ReportePersonaFilaDto? personaObjetivo;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.IsAdmin && !Sesion.IsDocente)
        {
            Navigation.NavigateTo("/");
            return;
        }

        try
        {
            if (Sesion.IsAdmin)
            {
                docentes = await ReporteApi.GetDocentesAsync();
            }
            else
            {
                await GenerarReporte();
            }
        }
        catch (Exception ex)
        {
            mensaje = "Error al cargar docentes: " + ex.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_cargarPdf && pdfBase64 != null)
        {
            _cargarPdf = false;
            await JS.InvokeVoidAsync("setIframeSrc", "pdfFrame", pdfBase64, "application/pdf");
        }
    }

    private async Task GenerarReporte()
    {
        int idObjetivo = Sesion.IsAdmin ? docenteId : (Sesion.PersonaId ?? 0);
        if (idObjetivo == 0)
        {
            mensaje = "Seleccione un docente.";
            return;
        }

        try
        {
            byte[] pdfBytes = await ReporteApi.GetRendimientoDocentePdfAsync(idObjetivo);
            pdfBase64 = Convert.ToBase64String(pdfBytes);
            personaObjetivo = docentes?.FirstOrDefault(d => d.Id == idObjetivo);
            if (personaObjetivo == null)
            {
                var p = await PersonaApi.GetBasicoAsync(idObjetivo);
                if (p != null)
                    personaObjetivo = new ReportePersonaFilaDto(p.Id, p.Nombre, p.Apellido, p.Legajo);
            }

            _cargarPdf = true;
            StateHasChanged();
            mensaje = "Reporte generado correctamente.";
        }
        catch (Exception ex)
        {
            mensaje = "Error al generar reporte: " + ex.Message;
        }
    }

    private async Task DescargarPdf()
    {
        if (pdfBase64 == null) return;
        var persona = personaObjetivo;
        string nombreArchivo = persona != null
            ? $"reporte-rendimiento-docente-{persona.Legajo}-{persona.Nombre}-{persona.Apellido}-{DateTime.Now:yyyyMMdd}"
            : $"reporte-rendimiento-docente-{DateTime.Now:yyyyMMdd}";
        await JS.InvokeVoidAsync("downloadFile",
            $"{nombreArchivo}.pdf",
            "application/pdf",
            pdfBase64);
    }

    private void OcultarMensaje()
    {
        mensaje = string.Empty;
    }
}
