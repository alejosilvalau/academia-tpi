@page "/dictados"
@attribute [Authorize(Roles="Administrador")]
@inject DocenteCursoServicio DocenteCursoServicio
@inject CursoServicio CursoServicio
@inject PersonaServicio PersonaServicio
@inject UI.Web.Services.SesionService Sesion
@inject NavigationManager Navigation

<div class="md-card">
    <div class="md-card-header-actions">
        <span>Dictados (Asignacion de Docentes a Cursos)</span>
        <div class="md-btn-group">
            <button class="md-btn md-btn-accent" @onclick="Nuevo">+ Nuevo</button>
            <button class="md-btn md-btn-primary" @onclick="Cargar">Refrescar</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="md-message @(mensajeEsError ? "md-message-error" : "md-message-success")">@mensaje</div>
    }

    @if (modoForm != ModoForm.Ninguno)
    {
        <div class="md-card" style="border:1px solid var(--border);">
            <div class="md-card-header">@(modoForm == ModoForm.Alta ? "Nuevo Dictado" : "Editar Dictado")</div>
            <EditForm Model="actual" OnValidSubmit="Guardar">
                <div class="md-form-row-3">
                    <div class="md-form-group">
                        <label class="md-label">Curso</label>
                        <select class="md-select" @bind="actual.CursoId">
                            <option value="0">-- Seleccione --</option>
                            @if (cursos != null)
                            {
                                @foreach (var c in cursos)
                                {
                                    <option value="@c.ID">@c.Descripcion</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="md-form-group">
                        <label class="md-label">Docente</label>
                        <select class="md-select" @bind="actual.DocenteId">
                            <option value="0">-- Seleccione --</option>
                            @if (docentes != null)
                            {
                                @foreach (var d in docentes)
                                {
                                    <option value="@d.ID">@d.Nombre @d.Apellido</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="md-form-group">
                        <label class="md-label">Cargo</label>
                        <select class="md-select" @bind="cargoSeleccionado">
                            <option value="0">Profesor</option>
                            <option value="1">Jefe De Catedra</option>
                            <option value="2">Auxiliar</option>
                        </select>
                    </div>
                </div>
                <div class="md-form-actions">
                    <button class="md-btn md-btn-cancel" type="button" @onclick="Cancelar">Cancelar</button>
                    <button class="md-btn md-btn-primary" type="submit">Guardar</button>
                </div>
            </EditForm>
        </div>
    }

    @if (lista == null)
    {
        <div class="md-loading"><div class="md-spinner"></div><p>Cargando...</p></div>
    }
    else if (lista.Count == 0)
    {
        <div class="md-empty"><div class="md-empty-icon">&#9830;</div><p>No hay dictados registrados</p></div>
    }
    else
    {
        <table class="md-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Curso</th>
                    <th>Docente</th>
                    <th>Cargo</th>
                    <th style="width:120px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr class="@(seleccionadaId == item.ID ? "selected" : "")" @onclick="() => Seleccionar(item.ID)">
                        <td>@item.ID</td>
                        <td>@item.Curso?.Descripcion</td>
                        <td>@item.Docente?.Nombre @item.Docente?.Apellido</td>
                        <td><span class="md-badge md-badge-accent">@FormatCargo(item.Cargo)</span></td>
                        <td class="md-table-actions">
                            <button class="md-btn md-btn-primary md-btn-sm" @onclick="() => Editar(item.ID)">Editar</button>
                            <button class="md-btn md-btn-danger md-btn-sm" @onclick="() => Eliminar(item.ID)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<DocenteCurso>? lista;
    private List<Curso>? cursos;
    private List<Persona>? docentes;
    private DocenteCurso actual = new();
    private ModoForm modoForm = ModoForm.Ninguno;
    private int seleccionadaId;
    private string mensaje = "";
    private bool mensajeEsError = false;
    private string cargoSeleccionado = "0";

    enum ModoForm { Ninguno, Alta, Modificacion }

    protected override void OnInitialized()
    {
        if (!Sesion.ValidarPermisos(Dominio.Persona.TiposPersonas.Administrador))
        {
            Navigation.NavigateTo("/");
            return;
        }
        cursos = CursoServicio.GetAll();
        docentes = PersonaServicio.GetByTipo(Persona.TiposPersonas.Docente);
        Cargar();
    }

    private void Cargar()
    {
        try { lista = DocenteCursoServicio.GetAll(); }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private void Seleccionar(int id) => seleccionadaId = id;

    private void Nuevo()
    {
        actual = new DocenteCurso();
        cargoSeleccionado = "0";
        modoForm = ModoForm.Alta;
        seleccionadaId = 0;
    }

    private void Editar(int id)
    {
        var item = DocenteCursoServicio.GetOne(id);
        if (item == null) return;
        actual = item;
        cargoSeleccionado = ((int)item.Cargo).ToString();
        modoForm = ModoForm.Modificacion;
        seleccionadaId = id;
    }

    private void Cancelar()
    {
        modoForm = ModoForm.Ninguno;
        actual = new DocenteCurso();
    }

    private void Guardar()
    {
        try
        {
            if (actual.CursoId == 0) { mostrarMensaje("Seleccione un curso.", true); return; }
            if (actual.DocenteId == 0) { mostrarMensaje("Seleccione un docente.", true); return; }
            actual.Cargo = (DocenteCurso.TiposCargos)int.Parse(cargoSeleccionado);

            if (modoForm == ModoForm.Alta)
                DocenteCursoServicio.AsignarDocente(actual.DocenteId, actual.CursoId, actual.Cargo);
            else
                DocenteCursoServicio.Update(actual);

            mostrarMensaje("Guardado correctamente.", false);
            Cancelar();
            Cargar();
        }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private void Eliminar(int id)
    {
        var item = DocenteCursoServicio.GetOne(id);
        if (item == null) return;
        try
        {
            DocenteCursoServicio.Delete(item);
            mostrarMensaje("Eliminado correctamente.", false);
            Cargar();
        }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private void mostrarMensaje(string msg, bool esError)
    {
        mensaje = msg;
        mensajeEsError = esError;
    }

    private string FormatCargo(DocenteCurso.TiposCargos cargo) => cargo switch
    {
        DocenteCurso.TiposCargos.Profesor => "Profesor",
        DocenteCurso.TiposCargos.JefeDeCatedra => "Jefe De Catedra",
        DocenteCurso.TiposCargos.Auxiliar => "Auxiliar",
        _ => cargo.ToString()
    };
}
