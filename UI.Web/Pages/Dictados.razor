@page "/dictados"
@attribute [Authorize(Roles="Administrador")]
@inject DocenteCursoClient Api
@inject CursoClient CursoApi
@inject PersonaClient PersonaApi
@inject UI.Web.Services.SesionService Sesion
@inject NavigationManager Navigation
@using Utils

<div class="md-card">
    <div class="md-card-header-actions">
        <span>Tabla de Dictados</span>
        <div class="md-btn-group">
            <button class="md-btn md-btn-accent" @onclick="Nuevo">+ Nuevo</button>
        </div>
    </div>

    <AutoRefresh OnTick="Cargar" />
    <MensajeFeedback Mensaje="@mensaje" EsError="mensajeEsError" Ocultar="OcultarMensaje" />

    @if (modoForm != ModoForm.Ninguno)
    {
        <div class="md-card" style="border:1px solid var(--border);">
            <div class="md-card-header">@(modoForm == ModoForm.Alta ? "Nuevo Dictado" : "Editar Dictado")</div>
            <EditForm Model="actual" OnValidSubmit="Guardar">
                <div class="md-form-row-3">
                    <div class="md-form-group">
                        <label class="md-label">Curso</label>
                        <select class="md-select" @bind="actual.CursoId" disabled="@(modoForm == ModoForm.Modificacion)">
                            <option value="0">-- Seleccione --</option>
                            @if (cursos != null)
                            {
                                @foreach (var c in cursos)
                                {
                                    <option value="@c.Id">@Formato.ToTitleCase(c.MateriaDescripcion) - @Formato.ToTitleCase(c.ComisionDescripcion) - @c.AnioCalendario</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="md-form-group">
                        <label class="md-label">Docente</label>
                        <select class="md-select" @bind="actual.DocenteId" disabled="@(modoForm == ModoForm.Modificacion)">
                            <option value="0">-- Seleccione --</option>
                            @if (docentes != null)
                            {
                                @foreach (var d in docentes)
                                {
                                    <option value="@d.Id">@Formato.ToTitleCase(d.Nombre) @Formato.ToTitleCase(d.Apellido)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="md-form-group">
                        <label class="md-label">Cargo</label>
                        <select class="md-select" @bind="cargoSeleccionado">
                            <option value="0">Profesor</option>
                            <option value="1">Jefe De Catedra</option>
                            <option value="2">Auxiliar</option>
                        </select>
                    </div>
                </div>
                <div class="md-form-actions">
                    <button class="md-btn md-btn-cancel" type="button" @onclick="Cancelar">Cancelar</button>
                    <button class="md-btn md-btn-primary" type="submit">Guardar</button>
                </div>
            </EditForm>
        </div>
    }

    @if (lista == null)
    {
        <div class="md-loading"><div class="md-spinner"></div><p>Cargando...</p></div>
    }
    else if (lista.Count == 0)
    {
        <div class="md-empty"><div class="md-empty-icon">&#9830;</div><p>No hay dictados registrados</p></div>
    }
    else
    {
        <table class="md-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Curso</th>
                    <th>Docente</th>
                    <th>Cargo</th>
                    <th style="width:120px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in lista)
                {
                    <tr class="@(seleccionadaId == item.Id ? "selected" : "")" @onclick="() => Seleccionar(item.Id)">
                        <td>@item.Id</td>
                        <td>@Formato.ToTitleCase(item.CursoMateriaDescripcion ?? "") - @Formato.ToTitleCase(item.CursoComisionDescripcion ?? "") - @item.CursoAnioCalendario</td>
                        <td>@Formato.ToTitleCase(item.DocenteNombre ?? "") @Formato.ToTitleCase(item.DocenteApellido ?? "")</td>
                        <td><span class="md-badge md-badge-accent">@FormatCargo(item.Cargo)</span></td>
                        <td class="md-table-actions">
                            <button class="md-btn md-btn-primary md-btn-sm" @onclick="() => Editar(item.Id)">Editar</button>
                            <button class="md-btn md-btn-danger md-btn-sm" @onclick="() => Eliminar(item.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<DocenteCursoDto>? lista;
    private List<CursoDto>? cursos;
    private List<PersonaDto>? docentes;
    private DocenteCursoRequest actual = new();
    private ModoForm modoForm = ModoForm.Ninguno;
    private int seleccionadaId;
    private string mensaje = "";
    private bool mensajeEsError = false;
    private string cargoSeleccionado = "0";

    enum ModoForm { Ninguno, Alta, Modificacion }

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.ValidarPermisos(TipoPersona.Administrador))
        {
            Navigation.NavigateTo("/");
            return;
        }
        try
        {
            cursos = await CursoApi.GetAllAsync();
            docentes = await PersonaApi.GetByTipoAsync(TipoPersona.Docente);
        }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
        await Cargar();
    }

    private async Task Cargar()
    {
        try { lista = await Api.GetAllAsync(); }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private void Seleccionar(int id) => seleccionadaId = id;

    private void Nuevo()
    {
        actual = new DocenteCursoRequest();
        cargoSeleccionado = "0";
        modoForm = ModoForm.Alta;
        seleccionadaId = 0;
    }

    private async Task Editar(int id)
    {
        var item = await Api.GetOneAsync(id);
        if (item == null) return;
        actual = new DocenteCursoRequest
        {
            CursoId = item.CursoId,
            DocenteId = item.DocenteId,
            Cargo = item.Cargo
        };
        cargoSeleccionado = ((int)item.Cargo).ToString();
        modoForm = ModoForm.Modificacion;
        seleccionadaId = id;
    }

    private void Cancelar()
    {
        modoForm = ModoForm.Ninguno;
        actual = new DocenteCursoRequest();
    }

    private async Task Guardar()
    {
        try
        {
            if (actual.CursoId == 0) { mostrarMensaje("Seleccione un curso.", true); return; }
            if (actual.DocenteId == 0) { mostrarMensaje("Seleccione un docente.", true); return; }
            actual.Cargo = (CargoDocente)int.Parse(cargoSeleccionado);

            if (modoForm == ModoForm.Alta)
                await Api.AsignarAsync(new AsignarDocenteRequest
                {
                    DocenteId = actual.DocenteId,
                    CursoId = actual.CursoId,
                    Cargo = actual.Cargo
                });
            else
                await Api.UpdateAsync(seleccionadaId, actual);

            mostrarMensaje("Guardado correctamente.", false);
            Cancelar();
            await Cargar();
        }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private async Task Eliminar(int id)
    {
        try
        {
            await Api.DeleteAsync(id);
            mostrarMensaje("Eliminado correctamente.", false);
            await Cargar();
        }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private void mostrarMensaje(string msg, bool esError)
    {
        mensaje = msg;
        mensajeEsError = esError;
    }

    private string FormatCargo(CargoDocente cargo) => cargo switch
    {
        CargoDocente.Profesor => "Profesor",
        CargoDocente.JefeDeCatedra => "Jefe De Catedra",
        CargoDocente.Auxiliar => "Auxiliar",
        _ => cargo.ToString()
    };

    private void OcultarMensaje()
    {
        mensaje = "";
    }
}
