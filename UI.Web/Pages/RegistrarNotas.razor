@page "/registrar-notas"
@page "/registrar-notas/{docenteId:int}"
@attribute [Authorize(Roles="Administrador,Docente")]
@inject InscripcionClient InscripcionApi
@inject DocenteCursoClient DocenteCursoApi
@inject PersonaClient PersonaApi
@inject UI.Web.Services.SesionService Sesion
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Utils

<div class="md-card">
    <div class="md-card-header-actions">
        <span>Tabla de Registrar Notas @(tituloDocente)</span>
    </div>

    <AutoRefresh OnTick="RefrescarCursos" />
    <MensajeFeedback Mensaje="@mensaje" EsError="mensajeEsError" Ocultar="OcultarMensaje" />

    @if (cursos == null)
    {
        <div class="md-loading"><div class="md-spinner"></div><p>Cargando...</p></div>
    }
    else if (cursos.Count == 0)
    {
        <div class="md-empty"><div class="md-empty-icon">&#9998;</div><p>El docente no tiene cursos asignados</p></div>
    }
    else
    {
        <div class="md-form-row">
            <div class="md-form-group">
                <label class="md-label">Curso</label>
                <select class="md-select" @bind="cursoIdSeleccionado" @bind:after="CargarInscripciones">
                    <option value="0">-- Seleccione un curso --</option>
                    @foreach (var c in cursos)
                    {
                        <option value="@c.CursoId">@Formato.ToTitleCase(c.CursoMateriaDescripcion ?? "") - @Formato.ToTitleCase(c.CursoComisionDescripcion ?? "") - @c.CursoAnioCalendario</option>
                    }
                </select>
            </div>
            <div class="md-form-group"></div>
        </div>

        @if (inscripciones != null && inscripciones.Count > 0)
        {
            <table class="md-table">
                <thead>
                    <tr>
                        <th>Legajo</th>
                        <th>Alumno</th>
                        <th>Condicion Actual</th>
                        <th>Nota Actual</th>
                        <th>Nueva Nota</th>
                        <th style="width:100px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in inscripciones)
                    {
                        <tr>
                            <td>@item.AlumnoLegajo</td>
                            <td>@Formato.ToTitleCase(item.AlumnoNombre ?? "") @Formato.ToTitleCase(item.AlumnoApellido ?? "")</td>
                            <td><span class="md-badge md-badge-primary">@item.Condicion</span></td>
                            <td>@(item.Nota?.ToString() ?? "-")</td>
                            <td>
                                <input class="md-input" type="number" min="0" max="10" style="width:80px;"
                                       @bind="notas[item.Id]" />
                            </td>
                            <td>
                                <button class="md-btn md-btn-primary md-btn-sm" @onclick="() => Calificar(item.Id)">Guardar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (cursoIdSeleccionado != 0)
        {
            <div class="md-empty"><div class="md-empty-icon">&#9998;</div><p>No hay inscripciones en este curso</p></div>
        }
    }
</div>

@code {
    [Parameter]
    public int? docenteId { get; set; }

    private List<DocenteCursoDto>? cursos;
    private List<InscripcionDto>? inscripciones;
    private string mensaje = "";
    private bool mensajeEsError = false;
    private int cursoIdSeleccionado;
    private Dictionary<int, int?> notas = new();
    private int docenteObjetivoId;
    private string tituloDocente = "";

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.ValidarPermisos(TipoPersona.Docente))
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (Sesion.IsAdmin)
        {
            if (docenteId == null || docenteId.Value <= 0)
            {
                Navigation.NavigateTo("/personas?tipo=docente&seleccion=notas");
                return;
            }
            var docente = await PersonaApi.GetBasicoAsync(docenteId.Value);
            if (docente == null)
            {
                Navigation.NavigateTo("/personas?tipo=docente&seleccion=notas");
                return;
            }
            docenteObjetivoId = docente.Id;
            tituloDocente = $"- {Formato.ToTitleCase(docente.Nombre)} {Formato.ToTitleCase(docente.Apellido)}";
        }
        else
        {
            docenteObjetivoId = Sesion.PersonaId ?? 0;
        }

        await CargarCursos();
        if (cursoIdSeleccionado != 0)
            await CargarInscripciones();
    }

    private async Task CargarCursos()
    {
        try
        {
            var asignaciones = await DocenteCursoApi.GetByDocenteAsync(docenteObjetivoId);
            cursos = asignaciones
                .GroupBy(a => a.CursoId)
                .Select(g => g.First())
                .ToList();
        }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private async Task CargarInscripciones()
    {
        if (cursoIdSeleccionado == 0) { inscripciones = null; return; }
        try
        {
            inscripciones = await InscripcionApi.GetByCursoAsync(cursoIdSeleccionado);
            notas = new Dictionary<int, int?>();
            foreach (var ins in inscripciones)
            {
                notas[ins.Id] = ins.Nota;
            }
        }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private async Task RefrescarCursos()
    {
        try { await CargarCursos(); }
        catch { }
    }

    private async Task Calificar(int inscripcionId)
    {
        try
        {
            var inscripcion = inscripciones?.FirstOrDefault(i => i.Id == inscripcionId);
            if (inscripcion == null) return;

            var nota = notas.TryGetValue(inscripcionId, out int? n) ? n : null;
            var condicion = inscripcion.Condicion;

            if (nota.HasValue)
            {
                condicion = nota >= 6
                    ? CondicionInscripcion.Aprobado
                    : nota >= 4
                        ? CondicionInscripcion.Regular
                        : CondicionInscripcion.Inscripto;
            }

            await InscripcionApi.UpdateAsync(inscripcionId, new InscripcionRequest
            {
                AlumnoId = inscripcion.AlumnoId,
                CursoId = inscripcion.CursoId,
                Nota = nota,
                Condicion = condicion
            });

            mostrarMensaje("Calificacion guardada correctamente.", false);
            await CargarInscripciones();
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
        }
        catch (Exception ex) { mostrarMensaje("Error: " + ex.Message, true); }
    }

    private void mostrarMensaje(string msg, bool esError)
    {
        mensaje = msg;
        mensajeEsError = esError;
    }

    private void OcultarMensaje()
    {
        mensaje = "";
    }
}
