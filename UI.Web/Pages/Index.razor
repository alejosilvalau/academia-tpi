@page "/"
@attribute [Authorize]
@inject UI.Web.Services.SesionService Sesion

@if (Sesion.IsLoggedIn)
{
    <div class="md-card">
        <div class="md-card-header">Bienvenido, @Sesion.UsuarioActual?.Persona?.Nombre @Sesion.UsuarioActual?.Persona?.Apellido</div>
        <p style="color:var(--text-secondary);margin-bottom:20px;">
            Sistema de gestion academica
        </p>
    </div>

    <div class="dashboard-grid">
        @if (Sesion.IsAdmin)
        {
            <a href="/especialidades" class="dashboard-card">
                <div class="dashboard-card-icon">&#9830;</div>
                <div class="dashboard-card-text">
                    <h3>Especialidades</h3>
                    <p>Gestionar especialidades</p>
                </div>
            </a>
            <a href="/planes" class="dashboard-card">
                <div class="dashboard-card-icon">&#9830;</div>
                <div class="dashboard-card-text">
                    <h3>Planes</h3>
                    <p>Gestionar planes de estudio</p>
                </div>
            </a>
            <a href="/materias" class="dashboard-card">
                <div class="dashboard-card-icon">&#9830;</div>
                <div class="dashboard-card-text">
                    <h3>Materias</h3>
                    <p>Gestionar materias</p>
                </div>
            </a>
            <a href="/comisiones" class="dashboard-card">
                <div class="dashboard-card-icon">&#9830;</div>
                <div class="dashboard-card-text">
                    <h3>Comisiones</h3>
                    <p>Gestionar comisiones</p>
                </div>
            </a>
            <a href="/cursos" class="dashboard-card">
                <div class="dashboard-card-icon">&#9830;</div>
                <div class="dashboard-card-text">
                    <h3>Cursos</h3>
                    <p>Gestionar cursos</p>
                </div>
            </a>
            <a href="/personas" class="dashboard-card">
                <div class="dashboard-card-icon">&#9830;</div>
                <div class="dashboard-card-text">
                    <h3>Personas</h3>
                    <p>Gestionar alumnos, docentes y administradores</p>
                </div>
            </a>
            <a href="/dictados" class="dashboard-card">
                <div class="dashboard-card-icon">&#9830;</div>
                <div class="dashboard-card-text">
                    <h3>Dictados</h3>
                    <p>Gestionar asignacion de docentes a cursos</p>
                </div>
            </a>
            <a href="/usuarios" class="dashboard-card">
                <div class="dashboard-card-icon">&#9830;</div>
                <div class="dashboard-card-text">
                    <h3>Usuarios</h3>
                    <p>Gestionar usuarios del sistema</p>
                </div>
            </a>
            <a href="/personas?tipo=alumno&seleccion=inscripcion" class="dashboard-card">
                <div class="dashboard-card-icon">&#9998;</div>
                <div class="dashboard-card-text">
                    <h3>Inscripciones</h3>
                    <p>Inscribir alumnos a cursos</p>
                </div>
            </a>
            <a href="/personas?tipo=docente&seleccion=notas" class="dashboard-card">
                <div class="dashboard-card-icon">&#9998;</div>
                <div class="dashboard-card-text">
                    <h3>Registrar Notas</h3>
                    <p>Calificar alumnos en cursos</p>
                </div>
            </a>
            <a href="/reportes/rendimiento-docente" class="dashboard-card">
                <div class="dashboard-card-icon">&#9776;</div>
                <div class="dashboard-card-text">
                    <h3>Rendimiento Docente</h3>
                    <p>Ver reporte de rendimiento docente</p>
                </div>
            </a>
            <a href="/reportes/rendimiento-alumnos" class="dashboard-card">
                <div class="dashboard-card-icon">&#9776;</div>
                <div class="dashboard-card-text">
                    <h3>Rendimiento Alumnos</h3>
                    <p>Ver reporte de rendimiento de alumnos</p>
                </div>
            </a>
        }
        @if (Sesion.IsAlumno)
        {
            <a href="/inscripciones" class="dashboard-card">
                <div class="dashboard-card-icon">&#9998;</div>
                <div class="dashboard-card-text">
                    <h3>Inscripciones</h3>
                    <p>Inscribirse a cursos</p>
                </div>
            </a>
            <a href="/reportes/rendimiento-alumnos" class="dashboard-card">
                <div class="dashboard-card-icon">&#9776;</div>
                <div class="dashboard-card-text">
                    <h3>Rendimiento Alumnos</h3>
                    <p>Ver reporte de rendimiento</p>
                </div>
            </a>
        }
        @if (Sesion.IsDocente)
        {
            <a href="/registrar-notas" class="dashboard-card">
                <div class="dashboard-card-icon">&#9998;</div>
                <div class="dashboard-card-text">
                    <h3>Registrar Notas</h3>
                    <p>Calificar alumnos en cursos</p>
                </div>
            </a>
            <a href="/reportes/rendimiento-docente" class="dashboard-card">
                <div class="dashboard-card-icon">&#9776;</div>
                <div class="dashboard-card-text">
                    <h3>Rendimiento Docente</h3>
                    <p>Ver reporte de rendimiento</p>
                </div>
            </a>
            <a href="/reportes/rendimiento-alumnos" class="dashboard-card">
                <div class="dashboard-card-icon">&#9776;</div>
                <div class="dashboard-card-text">
                    <h3>Rendimiento Alumnos</h3>
                    <p>Ver reporte de rendimiento de alumnos</p>
                </div>
            </a>
        }
    </div>
}
else
{
    <div class="md-loading">
        <div class="md-spinner"></div>
        <p>Cargando...</p>
    </div>
}
