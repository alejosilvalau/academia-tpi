@inherits LayoutComponentBase
@inject UI.Web.Services.SesionService Sesion
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (Sesion.IsLoggedIn)
{
    <div class="sidebar">
        <div class="sidebar-logo">ACADEMIA <span>TPI</span></div>

        <nav class="sidebar-nav">
            <div class="sidebar-section">
                <a href="/" class="sidebar-link @(IsActive("/"))">
                    <span class="icon">&#9750;</span> Inicio
                </a>
            </div>

            @if (Sesion.IsAdmin)
            {
                <div class="sidebar-section">
                    <div class="sidebar-section-title @(adminOpen ? "open" : "")" @onclick="ToggleAdministracion">
                        Administracion <span class="arrow">&#9654;</span>
                    </div>
                    <div class="sidebar-section-items @(adminOpen ? "open" : "")">
                        <a href="/especialidades" class="sidebar-link @(IsActive("/especialidades"))">
                            <span class="icon">&#9830;</span> Especialidades
                        </a>
                        <a href="/planes" class="sidebar-link @(IsActive("/planes"))">
                            <span class="icon">&#9830;</span> Planes
                        </a>
                        <a href="/comisiones" class="sidebar-link @(IsActive("/comisiones"))">
                            <span class="icon">&#9830;</span> Comisiones
                        </a>
                        <a href="/materias" class="sidebar-link @(IsActive("/materias"))">
                            <span class="icon">&#9830;</span> Materias
                        </a>
                        <a href="/cursos" class="sidebar-link @(IsActive("/cursos"))">
                            <span class="icon">&#9830;</span> Cursos
                        </a>
                        <a href="/personas" class="sidebar-link @(IsActive("/personas"))">
                            <span class="icon">&#9830;</span> Personas
                        </a>
                        <a href="/dictados" class="sidebar-link @(IsActive("/dictados"))">
                            <span class="icon">&#9830;</span> Dictados
                        </a>
                        <a href="/usuarios" class="sidebar-link @(IsActive("/usuarios"))">
                            <span class="icon">&#9830;</span> Usuarios
                        </a>
                    </div>
                </div>
            }

            <div class="sidebar-section">
                <div class="sidebar-section-title @(reportesOpen ? "open" : "")" @onclick="ToggleReportes">
                    Reportes <span class="arrow">&#9654;</span>
                </div>
                <div class="sidebar-section-items @(reportesOpen ? "open" : "")">
                    @if (Sesion.IsAdmin || Sesion.IsDocente)
                    {
                        <a href="/reportes/rendimiento-docente" class="sidebar-link @(IsActive("/reportes/rendimiento-docente"))">
                            <span class="icon">&#9776;</span> Rendimiento Docente
                        </a>
                    }
                    <a href="/reportes/rendimiento-alumnos" class="sidebar-link @(IsActive("/reportes/rendimiento-alumnos"))">
                        <span class="icon">&#9776;</span> Rendimiento Alumnos
                    </a>
                </div>
            </div>

            @if (Sesion.IsAdmin || Sesion.IsAlumno)
            {
                <div class="sidebar-section">
                    <a href="@(Sesion.IsAdmin ? "/personas?tipo=alumno&seleccion=inscripcion" : "/inscripciones")"
                       class="sidebar-link @(IsActive("/inscripciones"))">
                        <span class="icon">&#9998;</span> Inscripcion
                    </a>
                </div>
            }

            @if (Sesion.IsAdmin || Sesion.IsDocente)
            {
                <div class="sidebar-section">
                    <a href="@(Sesion.IsAdmin ? "/personas?tipo=docente&seleccion=notas" : "/registrar-notas")"
                       class="sidebar-link @(IsActive("/registrar-notas"))">
                        <span class="icon">&#9998;</span> Registrar Notas
                    </a>
                </div>
            }
        </nav>

        <div class="sidebar-footer">
            <a href="/login" @onclick="CerrarSesion" @onclick:preventDefault>
                <span class="icon">&#10140;</span> Cerrar Sesion
            </a>
        </div>
    </div>

    <div class="topbar">
        <div class="topbar-title">@GetPageTitle()</div>
        <div class="topbar-user">@Sesion.UsuarioActual?.Persona?.Nombre @Sesion.UsuarioActual?.Persona?.Apellido</div>
    </div>

    <div class="content">
        @Body
    </div>
}
else
{
    @Body
}

@code {
    private bool adminOpen;
    private bool reportesOpen;

    private void ToggleAdministracion() => adminOpen = !adminOpen;
    private void ToggleReportes() => reportesOpen = !reportesOpen;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !Sesion.IsLoggedIn && !Nav.Uri.EndsWith("/login"))
        {
            Nav.NavigateTo("/login", forceLoad: true);
        }
    }

    private string IsActive(string path)
    {
        var uri = new Uri(Nav.Uri);
        return uri.AbsolutePath == path ? "active" : "";
    }

    private string GetPageTitle()
    {
        var uri = new Uri(Nav.Uri);
        return uri.AbsolutePath switch
        {
            "/" => "Inicio",
            "/especialidades" => "Especialidades",
            "/planes" => "Planes",
            "/comisiones" => "Comisiones",
            "/materias" => "Materias",
            "/cursos" => "Cursos",
            "/personas" => "Personas",
            "/dictados" => "Dictados",
            "/usuarios" => "Usuarios",
            "/inscripciones" => "Inscripciones",
            "/registrar-notas" => "Registrar Notas",
            "/reportes/rendimiento-docente" => "Reporte de Rendimiento Docente",
            "/reportes/rendimiento-alumnos" => "Reporte de Rendimiento de Alumnos",
            _ => "Academia TPI"
        };
    }

    private async Task CerrarSesion()
    {
        await JS.InvokeVoidAsync("academiaLogout", "/api/auth/logout");
        Sesion.Invalidar();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
